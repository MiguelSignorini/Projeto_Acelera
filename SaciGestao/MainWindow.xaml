<Window x:Class="SaciGestao.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaciGestao - Sacilotti Imóveis"
        Width="1280" Height="780" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        xml:lang="pt-BR"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Cores do mockup -->
        <SolidColorBrush x:Key="CorMenuHover" Color="#2C3742"/>
        <SolidColorBrush x:Key="CorMenuAtivo" Color="#161C22"/>
        <SolidColorBrush x:Key="CorTextoMenu" Color="#AEB7C2"/>
        <SolidColorBrush x:Key="CorDestaque" Color="#8DBBF7"/>
        <SolidColorBrush x:Key="CorFundo" Color="#F1F3F6"/>
        <SolidColorBrush x:Key="CorTexto" Color="#1F2933"/>

        <!-- Item do menu lateral -->
        <Style x:Key="MenuItemStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Menu"/>
            <Setter Property="Foreground" Value="{StaticResource CorTextoMenu}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="fundo" CornerRadius="6"
                                Background="Transparent" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="15" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background"
                                        Value="{StaticResource CorMenuHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fundo" Property="Background"
                                        Value="{StaticResource CorMenuAtivo}"/>
                                <Setter Property="Foreground" Value="{StaticResource CorDestaque}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Sair no rodapé do menu lateral -->
        <Style x:Key="MenuSairStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CorTextoMenu}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="10,3,10,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" CornerRadius="6"
                                Background="Transparent" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7E8;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Sair" FontSize="15" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background"
                                        Value="{StaticResource CorMenuHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource CorDestaque}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão quadrado com ícone -->
        <Style x:Key="BotaoIconeStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" CornerRadius="6" Background="#E4E8EE">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#D3D9E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= MENU LATERAL ================= -->
        <Grid Grid.Column="0" Background="{StaticResource CorMenu}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

    
            <!-- Bloco branco com o Logo reduzido -->
            <Border Height="160"
        Padding="10" 
        Margin="-10,-10,0,-15">
    <Image Source="Resources/logo3.png" 
           MaxHeight="150" 
           MaxWidth="200"
           Stretch="Uniform" 
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           RenderOptions.BitmapScalingMode="HighQuality"/>
</Border>

            <!-- 2. Itens do menu -->
            <StackPanel Grid.Row="1">
                <RadioButton x:Name="rbDashboard" Content="Dashboard" Tag="&#xF0E2;"
                             Style="{StaticResource MenuItemStyle}" Checked="Menu_Checked"/>
                <RadioButton x:Name="rbImoveis" Content="Imóveis" Tag="&#xE80F;"
                             Style="{StaticResource MenuItemStyle}" Checked="Menu_Checked"/>
                <RadioButton x:Name="rbClientes" Content="Clientes" Tag="&#xE716;"
                             Style="{StaticResource MenuItemStyle}" Checked="Menu_Checked"/>
                <RadioButton x:Name="rbContratos" Content="Contratos" Tag="&#xE8A5;"
                             Style="{StaticResource MenuItemStyle}" Checked="Menu_Checked"/>
                <RadioButton x:Name="rbFinanceiro" Content="Financeiro" Tag="&#xE825;"
                             Style="{StaticResource MenuItemStyle}" Checked="Menu_Checked"/>
            </StackPanel>

            <!-- 3. Botão Sair fixo no rodapé -->
            <Button Grid.Row="2" Style="{StaticResource MenuSairStyle}"
                    Click="Sair_Click"/>
        </Grid>

        <!-- ================= ÁREA DIREITA ================= -->
        <Grid Grid.Column="1" Background="{StaticResource CorFundo}">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <Border Grid.Row="0" Background="White"
                    BorderBrush="#E1E5EA" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" FontSize="20" VerticalAlignment="Center"
                               Foreground="{StaticResource CorTexto}">
                        <Run Text="Bem-vindo,"/>
                        <Run x:Name="runNomeUsuario" Text="Administrador" FontWeight="Bold"/>
                    </TextBlock>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Campo de busca com placeholder -->
                        <Border Width="270" Height="40" CornerRadius="6" Background="#E9ECF0">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="#5B6570"
                                           VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Margin="10,0,0,0">
                                    <TextBox x:Name="txtBusca" BorderThickness="0"
                                             Background="Transparent" FontSize="14"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Buscar..." Foreground="#5F6B7A" FontSize="14"
                                               IsHitTestVisible="False" VerticalAlignment="Center"
                                               Margin="2,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=txtBusca}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <Button Content="&#xE77B;" Style="{StaticResource BotaoIconeStyle}"
                                ToolTip="Usuário"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Conteúdo da tela -->
            <ContentControl x:Name="AreaConteudo" Grid.Row="1" Margin="24"/>
        </Grid>
    </Grid>
</Window>