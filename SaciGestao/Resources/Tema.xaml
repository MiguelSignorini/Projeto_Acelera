<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Tema único do sistema: cores + estilos compartilhados por todas as telas.
        Uma tela só define um estilo próprio quando ele é exclusivo dela.

        Critérios WCAG 2.1 (W3C): texto com contraste mínimo de 4,5:1 e
        bordas de campos / ícones com no mínimo 3:1 contra o fundo branco.

        Azul     = ação principal (confiança, calma)
        Verde    = positivo / disponível / ativo
        Âmbar    = atenção moderada / reservado
        Vermelho = SOMENTE perigo: excluir, erro, cancelado

        Referências de layout: painéis de gestão imobiliária e de SaaS
        (menu lateral escuro fixo, cartões de indicadores no topo, tabelas
        com cabeçalho claro e linhas espaçadas, cartões de imóvel por status).
    -->

    <!-- ============================ CORES ============================ -->

    <!-- Ação principal -->
    <SolidColorBrush x:Key="Primaria" Color="#1E5BB8"/>            <!-- branco sobre ela: 6,6:1 -->
    <SolidColorBrush x:Key="PrimariaEscura" Color="#174A96"/>      <!-- hover -->
    <SolidColorBrush x:Key="PrimariaMaisEscura" Color="#123B78"/>  <!-- pressionado -->
    <SolidColorBrush x:Key="PrimariaClara" Color="#E8F0FB"/>       <!-- fundos suaves -->
    <SolidColorBrush x:Key="PrimariaMedia" Color="#BFD3F2"/>       <!-- bordas suaves em destaque -->

    <!-- Estados -->
    <SolidColorBrush x:Key="Sucesso" Color="#1E7B3A"/>
    <SolidColorBrush x:Key="SucessoClaro" Color="#E4F4E8"/>
    <SolidColorBrush x:Key="Atencao" Color="#8A5300"/>
    <SolidColorBrush x:Key="AtencaoClara" Color="#FFF4D6"/>
    <SolidColorBrush x:Key="Perigo" Color="#C62828"/>              <!-- vermelho só para perigo/erro -->
    <SolidColorBrush x:Key="PerigoClaro" Color="#FDECEC"/>

    <!-- Texto e bordas -->
    <SolidColorBrush x:Key="Texto" Color="#1A2230"/>
    <SolidColorBrush x:Key="TextoSuave" Color="#4B5563"/>          <!-- 7,5:1 no branco -->
    <SolidColorBrush x:Key="Borda" Color="#8591A1"/>               <!-- bordas de campos: 3,4:1 -->
    <SolidColorBrush x:Key="BordaSuave" Color="#E3E7ED"/>          <!-- divisórias e contorno de cartões -->
    <SolidColorBrush x:Key="FundoSuave" Color="#F6F8FB"/>          <!-- cabeçalho de tabela, hover de linha -->
    <SolidColorBrush x:Key="FundoApp" Color="#F2F4F8"/>            <!-- fundo atrás dos cartões -->

    <!-- Menu lateral / identidade -->
    <SolidColorBrush x:Key="CorMenu" Color="#141C2B"/>

    <!-- Sombra leve dos cartões -->
    <DropShadowEffect x:Key="SombraCartao" BlurRadius="18" ShadowDepth="2" Direction="270"
                      Opacity="0.06" Color="#0B1A33"/>
    <DropShadowEffect x:Key="SombraFlutuante" BlurRadius="28" ShadowDepth="6" Direction="270"
                      Opacity="0.16" Color="#0B1A33"/>

    <!-- ============================ CARTÕES ============================ -->

    <Style x:Key="Cartao" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordaSuave}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{StaticResource SombraCartao}"/>
    </Style>

    <!-- ============================ TEXTOS ============================ -->

    <Style x:Key="Rotulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="RotuloForm" TargetType="TextBlock" BasedOn="{StaticResource Rotulo}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>

    <Style x:Key="TextoCelula" TargetType="TextBlock">
        <Setter Property="Margin" Value="12,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ============================ CAMPOS ============================ -->

    <!-- Campo de texto arredondado, com borda azul ao focar -->
    <Style x:Key="CampoForm" TargetType="TextBox">
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource Primaria}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="borda" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borda" Property="BorderBrush" Value="{StaticResource PrimariaEscura}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="borda" Property="BorderBrush" Value="{StaticResource Primaria}"/>
                            <Setter TargetName="borda" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="PART_ContentHost" Property="Margin" Value="7,0"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="borda" Property="Background" Value="{StaticResource FundoSuave}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="borda" Property="Background" Value="{StaticResource FundoSuave}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de senha com o mesmo visual do CampoForm -->
    <Style x:Key="CampoSenha" TargetType="PasswordBox">
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource Primaria}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="borda" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borda" Property="BorderBrush" Value="{StaticResource PrimariaEscura}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="borda" Property="BorderBrush" Value="{StaticResource Primaria}"/>
                            <Setter TargetName="borda" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="PART_ContentHost" Property="Margin" Value="7,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CampoFormMultilinha" TargetType="TextBox" BasedOn="{StaticResource CampoForm}">
        <Setter Property="Height" Value="76"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- Item da lista suspensa dos ComboBox -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="fundo" Background="Transparent" CornerRadius="6"
                            Padding="10,8" Margin="4,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource FundoSuave}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource PrimariaClara}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimariaEscura}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox arredondado, usado nos filtros e nos formulários -->
    <Style x:Key="ComboArredondado" TargetType="ComboBox">
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="borda" Background="White" BorderBrush="{StaticResource Borda}"
                                            BorderThickness="1" CornerRadius="8">
                                        <TextBlock x:Name="seta" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" Foreground="{StaticResource TextoSuave}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,13,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="borda" Property="BorderBrush" Value="{StaticResource PrimariaEscura}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="borda" Property="BorderBrush" Value="{StaticResource Primaria}"/>
                                            <Setter TargetName="borda" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="seta" Property="Foreground" Value="{StaticResource Primaria}"/>
                                            <Setter TargetName="seta" Property="Text" Value="&#xE70E;"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="12,0,34,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <!-- Margem transparente em volta da lista para a sombra não ser cortada -->
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               HorizontalOffset="-10" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade">
                            <Border Padding="10,4,10,16" Background="Transparent">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Padding="0,4" Background="White"
                                        BorderBrush="{StaticResource BordaSuave}" BorderThickness="1"
                                        CornerRadius="10" Effect="{StaticResource SombraFlutuante}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox sem estilo próprio também fica arredondado -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource ComboArredondado}"/>

    <!-- DatePicker: mesma caixa arredondada dos outros campos -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                        <ContentControl x:Name="PART_Watermark" IsHitTestVisible="False" Focusable="False"
                                        Foreground="{StaticResource TextoSuave}" Opacity="0"
                                        VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Watermark" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,0,6,0"/>
        <Setter Property="IsTodayHighlighted" Value="True"/>
        <Setter Property="SelectedDateFormat" Value="Short"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="borda" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Foreground="{TemplateBinding Foreground}"
                                               Background="Transparent" BorderThickness="0"
                                               VerticalAlignment="Stretch"/>
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False"
                                    Width="30" Height="30" Cursor="Hand" ToolTip="Abrir calendário">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="fundo" Background="Transparent" CornerRadius="6">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                       Foreground="{StaticResource TextoSuave}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="fundo" Property="Background" Value="{StaticResource PrimariaClara}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                   PlacementTarget="{Binding ElementName=PART_TextBox}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borda" Property="BorderBrush" Value="{StaticResource PrimariaEscura}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="borda" Property="BorderBrush" Value="{StaticResource Primaria}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caixa de seleção com quadradinho arredondado e marca azul -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="caixa" Width="18" Height="18" CornerRadius="5"
                                Background="White" BorderBrush="{StaticResource Borda}" BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="marca" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Foreground="White" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" RecognizesAccessKey="True"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="caixa" Property="BorderBrush" Value="{StaticResource Primaria}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="caixa" Property="Background" Value="{StaticResource Primaria}"/>
                            <Setter TargetName="caixa" Property="BorderBrush" Value="{StaticResource Primaria}"/>
                            <Setter TargetName="marca" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ BOTÕES ============================ -->

    <Style x:Key="BotaoPrimario" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Primaria}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource PrimariaEscura}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource PrimariaMaisEscura}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoContorno" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="White" BorderBrush="#C5CCD6"
                            BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource FundoSuave}"/>
                            <Setter TargetName="fundo" Property="BorderBrush" Value="{StaticResource Borda}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="#E9EDF2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão vermelho para ações destrutivas (confirmar exclusão) -->
    <Style x:Key="BotaoPerigo" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Perigo}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="#A61F1F"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="#8A1818"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão de texto discreto (Excluir dentro do formulário) -->
    <Style x:Key="BotaoTextoPerigo" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Perigo}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="Transparent" CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource PerigoClaro}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botões de ícone nas linhas das tabelas (ver / editar / excluir) -->
    <Style x:Key="BotaoAcao" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D5DBE3"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBlock x:Name="icone" Text="{TemplateBinding Content}"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource PrimariaClara}"/>
                            <Setter TargetName="fundo" Property="BorderBrush" Value="{StaticResource PrimariaMedia}"/>
                            <Setter TargetName="icone" Property="Foreground" Value="{StaticResource Primaria}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoAcaoPerigo" TargetType="Button" BasedOn="{StaticResource BotaoAcao}">
        <Setter Property="Foreground" Value="{StaticResource Perigo}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource PerigoClaro}"/>
                            <Setter TargetName="fundo" Property="BorderBrush" Value="#F2B8B8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ TABELAS ============================ -->

    <Style x:Key="CabecalhoColuna" TargetType="DataGridColumnHeader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{StaticResource FundoSuave}" BorderBrush="{StaticResource BordaSuave}"
                            BorderThickness="0,0,0,1" Padding="12,12">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
    </Style>

    <Style x:Key="CelulaGrid" TargetType="DataGridCell">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" BorderBrush="#EDF0F4" BorderThickness="0,0,0,1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinhaGrid" TargetType="DataGridRow">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource FundoSuave}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ ROLAGEM ============================ -->

    <!-- Barra de rolagem fina, sem setas, que escurece ao passar o mouse -->
    <Style x:Key="PolegarRolagem" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="polegar" Background="#C3CAD4" CornerRadius="4"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="polegar" Property="Background" Value="#97A1AE"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="polegar" Property="Background" Value="#7C8694"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrilhoRolagem" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource TrilhoRolagem}" Command="ScrollBar.PageUpCommand"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource PolegarRolagem}" MinHeight="32"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource TrilhoRolagem}" Command="ScrollBar.PageDownCommand"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="4,2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrilhoRolagem}" Command="ScrollBar.PageLeftCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PolegarRolagem}" MinWidth="32"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrilhoRolagem}" Command="ScrollBar.PageRightCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Dica (ToolTip) escura e arredondada -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#1F2937" CornerRadius="6" Padding="10,6">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
