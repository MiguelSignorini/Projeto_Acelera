<Window x:Class="SaciGestao.Views.Dialogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xml:lang="pt-BR"
        FontFamily="Segoe UI"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height"
        Width="460" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Janela_PreviewKeyDown">

    <!-- Margem transparente em volta do cartão para a sombra aparecer -->
    <Border Margin="20" Background="White" CornerRadius="16"
            BorderBrush="{StaticResource BordaSuave}" BorderThickness="1"
            Effect="{StaticResource SombraFlutuante}"
            MouseLeftButtonDown="Cartao_MouseLeftButtonDown">
        <Grid Margin="28,26,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ícone em círculo colorido conforme o tipo (informação, sucesso, atenção, perigo) -->
            <Border x:Name="fundoIcone" Grid.RowSpan="2" Width="46" Height="46" CornerRadius="23"
                    VerticalAlignment="Top" Margin="0,0,16,0">
                <TextBlock x:Name="txtIcone" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="txtTitulo" Grid.Column="1" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource Texto}" TextWrapping="Wrap" Margin="0,2,0,0"/>

            <TextBlock x:Name="txtMensagem" Grid.Row="1" Grid.Column="1" FontSize="14" LineHeight="21"
                       Foreground="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <!-- Caminho de arquivo (ex.: PDF salvo): caixa cinza, texto selecionável -->
            <Border x:Name="caixaDetalhe" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed"
                    Background="{StaticResource FundoSuave}" BorderBrush="{StaticResource BordaSuave}"
                    BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,18,0,0">
                <TextBox x:Name="txtDetalhe" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontSize="12.5" Foreground="{StaticResource TextoSuave}" TextWrapping="Wrap"
                         Padding="0" Cursor="IBeam"/>
            </Border>

            <!-- Botões: o principal fica à direita -->
            <StackPanel x:Name="painelBotoes" Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,24,0,0"/>
        </Grid>
    </Border>
</Window>
