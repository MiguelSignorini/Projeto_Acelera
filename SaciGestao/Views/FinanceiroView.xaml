<UserControl x:Class="SaciGestao.Views.FinanceiroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xml:lang="pt-BR"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E6E9EE"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CabecalhoColuna" TargetType="DataGridColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="White" BorderBrush="{StaticResource Primaria}"
                                BorderThickness="0,0,0,2" Padding="8,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        </Style>

        <Style x:Key="TextoCelula" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="FINANCEIRO" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Texto}"/>
            <TextBlock Text="Resumo de entradas, receitas de contratos e movimentações financeiras."
                       FontSize="14" Foreground="{StaticResource TextoSuave}"/>
        </StackPanel>

        <!-- Cards de Indicadores -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
            <Border Style="{StaticResource Cartao}" Padding="20,16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="RECEITA TOTAL (CONTRATOS ATIVOS)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextoSuave}"/>
                    <TextBlock Text="{Binding ReceitaTotal, StringFormat=C2}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Primaria}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Cartao}" Padding="20,16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="TOTAL DE ENTRADAS" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextoSuave}"/>
                    <TextBlock Text="{Binding TotalEntradas, StringFormat=C2}" FontSize="26" FontWeight="Bold" Foreground="#2E9E5B" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Cartao}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="TOTAL DE SAÍDAS" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextoSuave}"/>
                    <TextBlock Text="{Binding TotalSaidas, StringFormat=C2}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextoSuave}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Tabela de Movimentações -->
        <Border Grid.Row="2" Style="{StaticResource Cartao}" Padding="20,8">
            <DataGrid ItemsSource="{Binding Movimentacoes}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      RowHeight="52" Background="Transparent" BorderThickness="0"
                      ColumnHeaderStyle="{StaticResource CabecalhoColuna}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding DataTexto}" Width="110" ElementStyle="{StaticResource TextoCelula}"/>
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="2*" ElementStyle="{StaticResource TextoCelula}"/>
                    <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="120" ElementStyle="{StaticResource TextoCelula}"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="150" ElementStyle="{StaticResource TextoCelula}"/>
                    <DataGridTextColumn Header="Valor" Binding="{Binding ValorTexto}" Width="130" ElementStyle="{StaticResource TextoCelula}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" ElementStyle="{StaticResource TextoCelula}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>