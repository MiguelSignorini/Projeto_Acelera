<UserControl x:Class="SaciGestao.Views.FinanceiroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:SaciGestao.Helpers"
             xml:lang="pt-BR"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <h:IguaisConverter x:Key="Iguais"/>
        <h:TextoParaVisibilidadeConverter x:Key="TextoParaVisibilidade"/>

        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E6E9EE"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Cartão de indicador com ícone -->
        <Style x:Key="CartaoIndicador" TargetType="Border" BasedOn="{StaticResource Cartao}">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="IconeIndicador" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RotuloIndicador" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ValorIndicador" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        </Style>

        <Style x:Key="DetalheIndicador" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        </Style>

        <!-- Botões -->
        <Style x:Key="BotaoPrimario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primaria}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{StaticResource PrimariaEscura}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoContorno" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="White" BorderBrush="{StaticResource Borda}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#F1F3F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botões pequenos da linha da tabela -->
        <Style x:Key="BotaoLinha" TargetType="Button" BasedOn="{StaticResource BotaoPrimario}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="BotaoLinhaContorno" TargetType="Button" BasedOn="{StaticResource BotaoContorno}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Atalhos de período: o ativo fica destacado -->
        <Style x:Key="ChipPeriodo" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="White" BorderBrush="{StaticResource Borda}"
                                BorderThickness="1" CornerRadius="16" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#F1F3F6"/>
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource Iguais}">
                                        <Binding Path="DataContext.PeriodoAtivo" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="fundo" Property="Background" Value="{StaticResource PrimariaClara}"/>
                                <Setter TargetName="fundo" Property="BorderBrush" Value="{StaticResource Primaria}"/>
                                <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tabela -->
        <Style x:Key="CabecalhoColuna" TargetType="DataGridColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="#F7F9FC" Padding="8,11">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
        </Style>

        <Style x:Key="CabecalhoColunaDireita" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CabecalhoColuna}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="CelulaGrid" TargetType="DataGridCell">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" BorderBrush="#EEF0F3" BorderThickness="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinhaGrid" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F7FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextoCelula" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TextoValor" TargetType="TextBlock" BasedOn="{StaticResource TextoCelula}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{StaticResource Sucesso}"/>
        </Style>

        <Style x:Key="TextoValorEmpresa" TargetType="TextBlock" BasedOn="{StaticResource TextoCelula}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
        </Style>

        <!-- Etiquetas (pílulas) -->
        <Style x:Key="Pilula" TargetType="Border">
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource PrimariaClara}"/>
        </Style>
        <Style x:Key="PilulaTipo" TargetType="Border" BasedOn="{StaticResource Pilula}">
            <Setter Property="Margin" Value="8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EhLocacao}" Value="False">
                    <Setter Property="Background" Value="{StaticResource AtencaoClara}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextoPilulaTipo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EhLocacao}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Atencao}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pagamento: Pendente (âmbar), atrasado (vermelho) ou Pago (verde) -->
        <Style x:Key="PilulaPagamento" TargetType="Border" BasedOn="{StaticResource Pilula}">
            <Setter Property="Background" Value="{StaticResource AtencaoClara}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Atrasado}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PerigoClaro}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Pago}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SucessoClaro}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextoPilulaPagamento" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Atencao}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Atrasado}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Perigo}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Pago}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Sucesso}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Barra do gráfico -->
        <Style x:Key="BarraMes" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
            <Setter Property="Background" Value="#E9ECF0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="6"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,10,10,24">

                <!-- ============ CABEÇALHO ============ -->
                <Grid h:Adaptavel.LarguraMinima="440">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="FINANCEIRO" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                        <TextBlock Text="Pagamentos de contratos, valores na conta e o ganho da empresa."
                                   FontSize="14" Foreground="{StaticResource TextoSuave}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource BotaoPrimario}" VerticalAlignment="Center"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding AbrirRegistrarCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Registrar pagamento" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ============ INDICADORES (do período filtrado) ============ -->
                <h:PainelAdaptavel LarguraMinima="240" EspacamentoVertical="12" Margin="0,18,0,18">

                    <Border Style="{StaticResource CartaoIndicador}" Background="{StaticResource Primaria}"
                            BorderBrush="{StaticResource Primaria}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="22" Background="#33FFFFFF" VerticalAlignment="Center">
                                <TextBlock Text="&#xE825;" Style="{StaticResource IconeIndicador}" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="RECEITA NA CONTA" Style="{StaticResource RotuloIndicador}" Foreground="#D6E4F8"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ReceitaNaConta, StringFormat=C2}" Style="{StaticResource ValorIndicador}" Foreground="White"/>
                                </Viewbox>
                                <TextBlock Style="{StaticResource DetalheIndicador}" Foreground="#D6E4F8">
                                    <Run Text="Locação "/><Run Text="{Binding TotalLocacao, StringFormat=C0, Mode=OneWay}"/><Run Text=" • Venda "/><Run Text="{Binding TotalVenda, StringFormat=C0, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CartaoIndicador}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource AtencaoClara}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE823;" Style="{StaticResource IconeIndicador}" Foreground="{StaticResource Atencao}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="A RECEBER (PENDENTE)" Style="{StaticResource RotuloIndicador}"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding AReceber, StringFormat=C2}" Style="{StaticResource ValorIndicador}"/>
                                </Viewbox>
                                <TextBlock Text="{Binding DetalhePendentes}" Style="{StaticResource DetalheIndicador}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CartaoIndicador}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource PrimariaClara}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8F1;" Style="{StaticResource IconeIndicador}" Foreground="{StaticResource Primaria}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GANHO DA EMPRESA" Style="{StaticResource RotuloIndicador}"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding GanhoEmpresa, StringFormat=C2}" Style="{StaticResource ValorIndicador}"
                                               Foreground="{StaticResource Primaria}"/>
                                </Viewbox>
                                <TextBlock Text="Percentual de cada imóvel, sobre o que já caiu na conta" Style="{StaticResource DetalheIndicador}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CartaoIndicador}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource SucessoClaro}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE716;" Style="{StaticResource IconeIndicador}" Foreground="{StaticResource Sucesso}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="REPASSE AOS PROPRIETÁRIOS" Style="{StaticResource RotuloIndicador}"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Repasse, StringFormat=C2}" Style="{StaticResource ValorIndicador}"/>
                                </Viewbox>
                                <TextBlock Style="{StaticResource DetalheIndicador}">
                                    <Run Text="Aguardando cair na conta: "/><Run Text="{Binding AguardandoConta, StringFormat=C2, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </h:PainelAdaptavel>

                <!-- ============ FILTROS ============ -->
                <Border Style="{StaticResource Cartao}" Padding="20,16" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="FILTROS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextoSuave}"
                                       VerticalAlignment="Center"/>
                            <Button Content="Limpar filtros" Style="{StaticResource BotaoContorno}" Height="32" FontSize="13"
                                    HorizontalAlignment="Right" Command="{Binding LimparFiltrosCommand}"/>
                        </Grid>

                        <!-- Atalhos de período -->
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Tudo" Style="{StaticResource ChipPeriodo}"
                                    Command="{Binding PeriodoCommand}" CommandParameter="tudo"/>
                            <Button Content="Este mês" Style="{StaticResource ChipPeriodo}"
                                    Command="{Binding PeriodoCommand}" CommandParameter="mes"/>
                            <Button Content="Mês anterior" Style="{StaticResource ChipPeriodo}"
                                    Command="{Binding PeriodoCommand}" CommandParameter="mesAnterior"/>
                            <Button Content="Últimos 30 dias" Style="{StaticResource ChipPeriodo}"
                                    Command="{Binding PeriodoCommand}" CommandParameter="30dias"/>
                            <Button Content="Este ano" Style="{StaticResource ChipPeriodo}"
                                    Command="{Binding PeriodoCommand}" CommandParameter="ano"/>
                        </WrapPanel>

                        <h:PainelAdaptavel LarguraMinima="190" EspacamentoVertical="12" Margin="0,4,0,0">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Data inicial" Style="{StaticResource Rotulo}"/>
                                <DatePicker SelectedDate="{Binding DataInicial, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Data final" Style="{StaticResource Rotulo}"/>
                                <DatePicker SelectedDate="{Binding DataFinal, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Tipo" Style="{StaticResource Rotulo}"/>
                                <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoSelecionado, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Pagamento" Style="{StaticResource Rotulo}"/>
                                <ComboBox ItemsSource="{Binding SituacoesPagamento}" SelectedItem="{Binding SituacaoSelecionada, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Buscar contrato / imóvel / cliente" Style="{StaticResource Rotulo}" TextTrimming="CharacterEllipsis"/>
                                <TextBox Style="{StaticResource Campo}" Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </h:PainelAdaptavel>
                    </StackPanel>
                </Border>

                <!-- ============ RECEBIDO POR MÊS ============ -->
                <Border Style="{StaticResource Cartao}" Padding="22,18" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Recebido por mês" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                        <TextBlock Text="Valores que já caíram na conta, dentro dos filtros." FontSize="13"
                                   Foreground="{StaticResource TextoSuave}" Margin="0,2,0,10"/>

                        <TextBlock Text="Nenhum valor na conta neste período." FontSize="13" Foreground="{StaticResource TextoSuave}"
                                   Visibility="{Binding SemMeses, Converter={StaticResource BoolVis}}"/>

                        <ItemsControl ItemsSource="{Binding Meses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rotulo}" FontSize="13" Foreground="{StaticResource TextoSuave}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding Percentual, Mode=OneWay}" Style="{StaticResource BarraMes}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ValorTexto}" FontSize="13" FontWeight="SemiBold"
                                                   TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ PAGAMENTOS ============ -->
                <Border Style="{StaticResource Cartao}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="22,16,22,12">
                            <TextBlock Text="Pagamentos" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource TextoSuave}"
                                       Text="{Binding QuantidadeMovimentacoes, StringFormat='{}{0} registro(s)'}"/>
                        </Grid>

                        <DataGrid h:Adaptavel.Tabela="True" Grid.Row="1" ItemsSource="{Binding Movimentacoes}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  RowHeaderWidth="0" RowHeight="64" MinHeight="200" MaxHeight="640"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  Background="Transparent" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource CabecalhoColuna}"
                                  CellStyle="{StaticResource CelulaGrid}"
                                  RowStyle="{StaticResource LinhaGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATA" Binding="{Binding DataTexto}" Width="100" ElementStyle="{StaticResource TextoCelula}"/>
                                <DataGridTextColumn Header="CONTRATO / IMÓVEL" Binding="{Binding Descricao}" Width="2*" MinWidth="120"
                                                    ElementStyle="{StaticResource TextoCelula}"/>
                                <DataGridTemplateColumn Header="TIPO" Width="110" h:Adaptavel.OcultarAbaixo="1050">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PilulaTipo}">
                                                <TextBlock Text="{Binding TipoTexto}" Style="{StaticResource TextoPilulaTipo}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="VALOR" Binding="{Binding ValorTexto}" Width="115"
                                                    HeaderStyle="{StaticResource CabecalhoColunaDireita}"
                                                    ElementStyle="{StaticResource TextoValor}"/>
                                <DataGridTextColumn Header="EMPRESA" h:Adaptavel.OcultarAbaixo="900" Binding="{Binding EmpresaTexto}" Width="115"
                                                    HeaderStyle="{StaticResource CabecalhoColunaDireita}"
                                                    ElementStyle="{StaticResource TextoValorEmpresa}"/>
                                <DataGridTemplateColumn Header="PAGAMENTO" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="8,0">
                                                <Border Style="{StaticResource PilulaPagamento}">
                                                    <TextBlock Text="{Binding PagamentoTexto}" Style="{StaticResource TextoPilulaPagamento}"/>
                                                </Border>
                                                <TextBlock Text="{Binding PagamentoDetalhe}" FontSize="11" Margin="2,3,0,0"
                                                           Foreground="{StaticResource TextoSuave}"/>
                                                <!-- Locação: só quando este check é marcado o valor cai na conta e conta nos totais -->
                                                <CheckBox Content="Caiu na conta" FontSize="12" Margin="2,2,0,0"
                                                          IsChecked="{Binding CaiuNaConta, Mode=OneWay}"
                                                          Visibility="{Binding MostrarCheckNaConta, Converter={StaticResource BoolVis}}"
                                                          Command="{Binding DataContext.AlternarNaContaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="AÇÃO" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Button Content="Registrar" Style="{StaticResource BotaoLinha}"
                                                        Visibility="{Binding MostrarRegistrar, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.AbrirRegistrarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Desfazer" Style="{StaticResource BotaoLinhaContorno}"
                                                        Visibility="{Binding MostrarDesfazer, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.DesfazerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="1" Text="Nenhum pagamento encontrado para os filtros escolhidos."
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"
                                   Foreground="{StaticResource TextoSuave}" FontSize="14"
                                   Visibility="{Binding SemMovimentacoes, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ REGISTRAR PAGAMENTO (janela por cima da tela) ============ -->
        <Grid Visibility="{Binding DialogoAberto, Converter={StaticResource BoolVis}}">
            <Border Background="#99000000" MouseDown="Fundo_MouseDown"/>

            <Border Style="{StaticResource Cartao}" Background="White" MaxWidth="560" Margin="14"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="660">
                    <StackPanel Margin="26,22,26,22">

                        <TextBlock Text="Registrar pagamento" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                        <TextBlock Text="Escolha o contrato, informe o valor e confirme. Enquanto não for confirmado, o pagamento continua Pendente."
                                   FontSize="13" Foreground="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <TextBlock Text="Contrato" Style="{StaticResource Rotulo}" Margin="0,18,0,6"/>
                        <ComboBox ItemsSource="{Binding ContratosDisponiveis}" SelectedItem="{Binding ContratoSelecionado, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Codigo, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" • "/><Run Text="{Binding ImovelTitulo, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding LocatarioNome, Mode=OneWay}"/><Run Text=" ("/><Run Text="{Binding TipoTexto, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Referência (parcela pendente)" Style="{StaticResource Rotulo}" Margin="0,14,0,6"/>
                        <ComboBox ItemsSource="{Binding ParcelasDisponiveis}" SelectedItem="{Binding ParcelaSelecionada, Mode=TwoWay}"
                                  DisplayMemberPath="ParcelaTexto"/>

                        <h:PainelAdaptavel LarguraMinima="200" EspacamentoVertical="12" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Valor recebido (R$)" Style="{StaticResource Rotulo}"/>
                                <TextBox h:Mascara.Tipo="Decimal" Style="{StaticResource Campo}"
                                         Text="{Binding ValorForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Data do pagamento" Style="{StaticResource Rotulo}"/>
                                <DatePicker SelectedDate="{Binding DataPagamentoForm, Mode=TwoWay}"/>
                            </StackPanel>
                        </h:PainelAdaptavel>

                        <Border Background="#EEF4FF" CornerRadius="8" Padding="12,8" Margin="0,14,0,0"
                                Visibility="{Binding ResumoEmpresa, Converter={StaticResource TextoParaVisibilidade}}">
                            <TextBlock Text="{Binding ResumoEmpresa}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Primaria}" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Observação (opcional)" Style="{StaticResource Rotulo}" Margin="0,14,0,6"/>
                        <TextBox Style="{StaticResource Campo}" Text="{Binding ObservacaoForm, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Confirmações -->
                        <Border BorderBrush="#E6E9EE" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,16,0,0">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding ConfirmadoForm, Mode=TwoWay}" FontSize="14" FontWeight="SemiBold">
                                    <TextBlock Text="Confirmo que o pagamento foi recebido" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding CaiuNaContaForm, Mode=TwoWay}" FontSize="14" Margin="0,10,0,0"
                                          Visibility="{Binding ContratoEhLocacao, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="O valor já caiu na conta (só então entra nos totais)" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding ErroForm}" Foreground="{StaticResource Perigo}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,12,0,0"
                                   Visibility="{Binding ErroForm, Converter={StaticResource TextoParaVisibilidade}}"/>

                        <WrapPanel HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Content="Cancelar" Style="{StaticResource BotaoContorno}" Margin="0,0,10,0"
                                    Command="{Binding FecharDialogoCommand}"/>
                            <Button Content="Registrar pagamento" Style="{StaticResource BotaoPrimario}"
                                    Command="{Binding ConfirmarRegistroCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
