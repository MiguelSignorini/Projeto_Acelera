<UserControl x:Class="SaciGestao.Views.FinanceiroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:SaciGestao.Helpers"
             xml:lang="pt-BR"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <h:IguaisConverter x:Key="Iguais"/>
        <h:TextoParaVisibilidadeConverter x:Key="TextoParaVisibilidade"/>

<!-- Cartão de indicador com ícone -->
        <Style x:Key="CartaoIndicador" TargetType="Border" BasedOn="{StaticResource Cartao}">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="IconeIndicador" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RotuloIndicador" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ValorIndicador" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        </Style>

        <Style x:Key="DetalheIndicador" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Campos, ComboBox e DatePicker usam o visual arredondado do Tema.xaml -->
        <Style x:Key="Campo" TargetType="TextBox" BasedOn="{StaticResource CampoForm}"/>

<!-- Botões pequenos da linha da tabela -->
        <Style x:Key="BotaoLinha" TargetType="Button" BasedOn="{StaticResource BotaoPrimario}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="BotaoLinhaContorno" TargetType="Button" BasedOn="{StaticResource BotaoContorno}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Atalhos de período: o ativo fica destacado -->
        <Style x:Key="ChipPeriodo" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="White" BorderBrush="{StaticResource Borda}"
                                BorderThickness="1" CornerRadius="16" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#F1F3F6"/>
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource Iguais}">
                                        <Binding Path="DataContext.PeriodoAtivo" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="fundo" Property="Background" Value="{StaticResource PrimariaClara}"/>
                                <Setter TargetName="fundo" Property="BorderBrush" Value="{StaticResource Primaria}"/>
                                <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

<Style x:Key="CabecalhoColunaDireita" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CabecalhoColuna}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

<Style x:Key="TextoValor" TargetType="TextBlock" BasedOn="{StaticResource TextoCelula}">
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{StaticResource Sucesso}"/>
        </Style>

        <Style x:Key="TextoValorEmpresa" TargetType="TextBlock" BasedOn="{StaticResource TextoCelula}">
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
        </Style>

        <!-- Etiquetas (pílulas) -->
        <Style x:Key="Pilula" TargetType="Border">
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource PrimariaClara}"/>
        </Style>
        <Style x:Key="PilulaTipo" TargetType="Border" BasedOn="{StaticResource Pilula}">
            <Setter Property="Margin" Value="12,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EhLocacao}" Value="False">
                    <Setter Property="Background" Value="{StaticResource AtencaoClara}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextoPilulaTipo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EhLocacao}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Atencao}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pagamento: Pendente (âmbar), atrasado (vermelho) ou Pago (verde) -->
        <Style x:Key="PilulaPagamento" TargetType="Border" BasedOn="{StaticResource Pilula}">
            <Setter Property="Background" Value="{StaticResource AtencaoClara}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Atrasado}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PerigoClaro}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Pago}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SucessoClaro}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextoPilulaPagamento" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Atencao}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Atrasado}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Perigo}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Pago}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Sucesso}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Linha clicável da lista de contratos ativos -->
        <Style x:Key="LinhaContrato" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="Transparent" BorderBrush="{StaticResource BordaSuave}"
                                BorderThickness="0,1,0,0" Padding="22,14">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{StaticResource FundoSuave}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{StaticResource PrimariaClara}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Situação do contrato: em dia (verde), com parcela atrasada (vermelho), quitado (cor da marca) -->
        <Style x:Key="PilulaContrato" TargetType="Border" BasedOn="{StaticResource Pilula}">
            <Setter Property="Background" Value="{StaticResource SucessoClaro}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ComAtraso}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PerigoClaro}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Quitado}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimariaClara}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextoPilulaContrato" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Sucesso}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ComAtraso}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Perigo}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Quitado}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RotuloDetalhe" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
        </Style>
        <Style x:Key="ValorDetalhe" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,12"/>
        </Style>
        <Style x:Key="CabecalhoParcela" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
        </Style>
        <Style x:Key="CelulaParcela" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Barra do gráfico -->
        <Style x:Key="BarraMes" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
            <Setter Property="Background" Value="#E9ECF0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="6"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,10,10,24">

                <!-- ============ CABEÇALHO ============ -->
                <Grid h:Adaptavel.LarguraMinima="280">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Financeiro" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                        <TextBlock Text="Pagamentos de contratos, valores na conta e o ganho da empresa."
                                   FontSize="14" Foreground="{StaticResource TextoSuave}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource BotaoPrimario}" VerticalAlignment="Center"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding AbrirRegistrarCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Registrar pagamento" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ============ INDICADORES (do período filtrado) ============ -->
                <h:PainelAdaptavel LarguraMinima="215" EspacamentoVertical="12" Margin="0,18,0,18">

                    <Border Style="{StaticResource CartaoIndicador}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource AtencaoClara}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE823;" Style="{StaticResource IconeIndicador}" Foreground="{StaticResource Atencao}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="A receber (pendente)" Style="{StaticResource RotuloIndicador}"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding AReceber, StringFormat=C2}" Style="{StaticResource ValorIndicador}"/>
                                </Viewbox>
                                <TextBlock Text="{Binding DetalhePendentes}" Style="{StaticResource DetalheIndicador}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CartaoIndicador}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource PrimariaClara}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8F1;" Style="{StaticResource IconeIndicador}" Foreground="{StaticResource Primaria}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ganho da empresa" Style="{StaticResource RotuloIndicador}"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding GanhoEmpresa, StringFormat=C2}" Style="{StaticResource ValorIndicador}"
                                               Foreground="{StaticResource Primaria}"/>
                                </Viewbox>
                                <TextBlock Text="Taxa dos aluguéis + comissões das vendas, só o que já foi recebido" Style="{StaticResource DetalheIndicador}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </h:PainelAdaptavel>

                <!-- ============ FILTROS ============ -->
                <Border Style="{StaticResource Cartao}" Padding="20,16" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="FILTROS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextoSuave}"
                                       VerticalAlignment="Center"/>
                            <Button Content="Limpar filtros" Style="{StaticResource BotaoContorno}" Height="32" FontSize="13"
                                    HorizontalAlignment="Right" Command="{Binding LimparFiltrosCommand}"/>
                        </Grid>

                        <!-- Atalhos de período -->
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Tudo" Style="{StaticResource ChipPeriodo}"
                                    Command="{Binding PeriodoCommand}" CommandParameter="tudo"/>
                            <Button Content="Este mês" Style="{StaticResource ChipPeriodo}"
                                    Command="{Binding PeriodoCommand}" CommandParameter="mes"/>
                            <Button Content="Mês anterior" Style="{StaticResource ChipPeriodo}"
                                    Command="{Binding PeriodoCommand}" CommandParameter="mesAnterior"/>
                            <Button Content="Últimos 30 dias" Style="{StaticResource ChipPeriodo}"
                                    Command="{Binding PeriodoCommand}" CommandParameter="30dias"/>
                            <Button Content="Este ano" Style="{StaticResource ChipPeriodo}"
                                    Command="{Binding PeriodoCommand}" CommandParameter="ano"/>
                        </WrapPanel>

                        <h:PainelAdaptavel LarguraMinima="190" EspacamentoVertical="12" Margin="0,4,0,0">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Data inicial" Style="{StaticResource Rotulo}"/>
                                <DatePicker SelectedDate="{Binding DataInicial, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Data final" Style="{StaticResource Rotulo}"/>
                                <DatePicker SelectedDate="{Binding DataFinal, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Tipo" Style="{StaticResource Rotulo}"/>
                                <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoSelecionado, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Pagamento" Style="{StaticResource Rotulo}"/>
                                <ComboBox ItemsSource="{Binding SituacoesPagamento}" SelectedItem="{Binding SituacaoSelecionada, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Buscar contrato / imóvel / cliente" Style="{StaticResource Rotulo}" TextTrimming="CharacterEllipsis"/>
                                <TextBox Style="{StaticResource Campo}" Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </h:PainelAdaptavel>
                    </StackPanel>
                </Border>

                <!-- ============ RECEBIDO POR MÊS ============ -->
                <Border Style="{StaticResource Cartao}" Padding="22,18" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Recebido por mês" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                        <TextBlock Text="Pagamentos registrados (recebidos na conta), dentro dos filtros." FontSize="13"
                                   Foreground="{StaticResource TextoSuave}" Margin="0,2,0,10"/>

                        <TextBlock Text="Nenhum valor na conta neste período." FontSize="13" Foreground="{StaticResource TextoSuave}"
                                   Visibility="{Binding SemMeses, Converter={StaticResource BoolVis}}"/>

                        <ItemsControl ItemsSource="{Binding Meses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rotulo}" FontSize="13" Foreground="{StaticResource TextoSuave}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding Percentual, Mode=OneWay}" Style="{StaticResource BarraMes}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ValorTexto}" FontSize="13" FontWeight="SemiBold"
                                                   TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ CONTRATOS ATIVOS ============ -->
                <Border Style="{StaticResource Cartao}" Padding="0" ClipToBounds="True" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="22,16,22,12">
                            <StackPanel>
                                <TextBlock Text="Contratos ativos" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                                <TextBlock Text="Clique em um contrato para ver o que já foi pago, o que falta e todas as parcelas."
                                           FontSize="13" Foreground="{StaticResource TextoSuave}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="13"
                                       Foreground="{StaticResource TextoSuave}"
                                       Text="{Binding QuantidadeContratosAtivos, StringFormat='{}{0} contrato(s)'}"/>
                        </Grid>

                        <TextBlock Text="Nenhum contrato ativo no momento." HorizontalAlignment="Center" Margin="0,16,0,28"
                                   Foreground="{StaticResource TextoSuave}" FontSize="14"
                                   Visibility="{Binding SemContratosAtivos, Converter={StaticResource BoolVis}}"/>

                        <!-- Cabeçalho da lista: mesmas colunas das linhas, para tudo ficar alinhado como uma tabela -->
                        <Border Background="{StaticResource FundoSuave}" BorderBrush="{StaticResource BordaSuave}"
                                BorderThickness="0,1,0,1" Padding="22,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" MinWidth="170"/>
                                <ColumnDefinition Width="1.3*" MinWidth="135"/>
                                <ColumnDefinition Width="1.3*" MinWidth="130"/>
                                <ColumnDefinition Width="1.6*" MinWidth="140"/>
                                <ColumnDefinition Width="1.1*" MinWidth="115"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>
                                <TextBlock Text="CONTRATO / IMÓVEL" Style="{StaticResource CabecalhoParcela}"/>
                                <TextBlock Grid.Column="1" Text="VALOR" Style="{StaticResource CabecalhoParcela}"/>
                                <TextBlock Grid.Column="2" Text="FALTA RECEBER" Style="{StaticResource CabecalhoParcela}"/>
                                <TextBlock Grid.Column="3" Text="ANDAMENTO" Style="{StaticResource CabecalhoParcela}"/>
                                <TextBlock Grid.Column="4" Text="PRÓXIMO VENC." Style="{StaticResource CabecalhoParcela}"/>
                                <TextBlock Grid.Column="5" Text="SITUAÇÃO" Style="{StaticResource CabecalhoParcela}"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding ContratosAtivos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinhaContrato}"
                                            Command="{Binding DataContext.AbrirDetalheCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" MinWidth="170"/>
                                <ColumnDefinition Width="1.3*" MinWidth="135"/>
                                <ColumnDefinition Width="1.3*" MinWidth="130"/>
                                <ColumnDefinition Width="1.6*" MinWidth="140"/>
                                <ColumnDefinition Width="1.1*" MinWidth="115"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Texto}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Codigo, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding ImovelTitulo, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="12" Foreground="{StaticResource TextoSuave}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                    <Run Text="{Binding TipoTexto, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding LocatarioNome, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding ValorContratoTexto}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding FaltaTexto}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <ProgressBar Value="{Binding Progresso, Mode=OneWay}" Style="{StaticResource BarraMes}" Height="8"/>
                                                <TextBlock Text="{Binding ParcelasTexto}" Style="{StaticResource RotuloDetalhe}" Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding ProximoVencimentoTexto}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Texto}"/>
                                            </StackPanel>

                                            <Border Grid.Column="5" Style="{StaticResource PilulaContrato}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding StatusTexto}" Style="{StaticResource TextoPilulaContrato}"/>
                                            </Border>

                                            <TextBlock Grid.Column="6" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="{StaticResource TextoSuave}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ PAGAMENTOS ============ -->
                <Border Style="{StaticResource Cartao}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="22,16,22,12">
                            <StackPanel>
                                <TextBlock Text="Pagamentos" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                                <TextBlock Text="{Binding DescricaoPeriodo}" FontSize="13" Foreground="{StaticResource TextoSuave}"
                                           Margin="0,2,60,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="13"
                                       Foreground="{StaticResource TextoSuave}"
                                       Text="{Binding QuantidadeMovimentacoes, StringFormat='{}{0} registro(s)'}"/>
                        </Grid>

                        <DataGrid h:Adaptavel.Tabela="True" Grid.Row="1" ItemsSource="{Binding Movimentacoes}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  RowHeaderWidth="0" RowHeight="64" MinHeight="200" MaxHeight="640"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  Background="Transparent" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource CabecalhoColuna}"
                                  CellStyle="{StaticResource CelulaGrid}"
                                  RowStyle="{StaticResource LinhaGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATA" Binding="{Binding DataTexto}" Width="100" ElementStyle="{StaticResource TextoCelula}"/>
                                <DataGridTemplateColumn Header="TIPO" Width="120" h:Adaptavel.OcultarAbaixo="1050">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PilulaTipo}">
                                                <TextBlock Text="{Binding TipoTexto}" Style="{StaticResource TextoPilulaTipo}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="CONTRATO / IMÓVEL" Width="2*" MinWidth="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="12,0">
                                                <TextBlock Text="{Binding ContratoResumo}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Texto}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Inquilino}" FontSize="12" Foreground="{StaticResource TextoSuave}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="REFERÊNCIA" Binding="{Binding MesReferenciaTexto}" Width="140"
                                                    h:Adaptavel.OcultarAbaixo="1000" ElementStyle="{StaticResource TextoCelula}"/>
                                <DataGridTextColumn Header="VALOR" Binding="{Binding ValorContratoTexto}" Width="155"
                                                    HeaderStyle="{StaticResource CabecalhoColunaDireita}"
                                                    ElementStyle="{StaticResource TextoValor}"/>
                                <DataGridTextColumn Header="EMPRESA" h:Adaptavel.OcultarAbaixo="900" Binding="{Binding EmpresaTexto}" Width="140"
                                                    HeaderStyle="{StaticResource CabecalhoColunaDireita}"
                                                    ElementStyle="{StaticResource TextoValorEmpresa}"/>
                                <DataGridTemplateColumn Header="PAGAMENTO" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="12,0">
                                                <Border Style="{StaticResource PilulaPagamento}">
                                                    <TextBlock Text="{Binding PagamentoTexto}" Style="{StaticResource TextoPilulaPagamento}"/>
                                                </Border>
                                                <TextBlock Text="{Binding PagamentoDetalhe}" FontSize="11" Margin="0,3,0,0"
                                                           Foreground="{StaticResource TextoSuave}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="AÇÃO" Width="125">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Button Content="Registrar" Style="{StaticResource BotaoLinha}"
                                                        Visibility="{Binding MostrarRegistrar, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.AbrirRegistrarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Desfazer" Style="{StaticResource BotaoLinhaContorno}"
                                                        Visibility="{Binding MostrarDesfazer, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.DesfazerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="1" Text="Nenhum pagamento encontrado para os filtros escolhidos."
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"
                                   Foreground="{StaticResource TextoSuave}" FontSize="14"
                                   Visibility="{Binding SemMovimentacoes, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ DETALHES DO CONTRATO (pop-up) ============ -->
        <Grid Visibility="{Binding DetalheAberto, Converter={StaticResource BoolVis}}">
            <Border Background="#99000000" MouseDown="FundoDetalhe_MouseDown"/>

            <Border Style="{StaticResource Cartao}" Background="White" MaxWidth="900" Margin="14"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <Border Background="{StaticResource Primaria}" CornerRadius="14,14,0,0" Padding="26,18">
                        <Grid DataContext="{Binding DetalheContrato}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#F3D5D4">
                                    <Run Text="{Binding Codigo, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding TipoTexto, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding ImovelTitulo}" FontSize="20" FontWeight="Bold" Foreground="White"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock FontSize="13" Foreground="#F3D5D4" TextWrapping="Wrap" Margin="0,4,0,0">
                                    <Run Text="Cliente: "/><Run Text="{Binding LocatarioNome, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   •   Proprietário: "/><Run Text="{Binding LocadorNome, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource PilulaContrato}" VerticalAlignment="Top" Background="White">
                                <TextBlock Text="{Binding StatusTexto}" Style="{StaticResource TextoPilulaContrato}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="560">
                        <StackPanel Margin="26,20,26,8" DataContext="{Binding DetalheContrato}">

                            <!-- Resumo: quanto foi pago, quanto falta, próximo vencimento -->
                            <h:PainelAdaptavel LarguraMinima="190" EspacamentoVertical="10">
                                <Border Background="{StaticResource FundoSuave}" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RotuloValorContrato}" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding ValorContratoTexto}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                                        <TextBlock Text="{Binding ValorContratoDetalhe}" Style="{StaticResource RotuloDetalhe}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SucessoClaro}" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RotuloPago}" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding TotalPagoTexto}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Sucesso}"/>
                                        <TextBlock Text="{Binding ParcelasTexto}" Style="{StaticResource RotuloDetalhe}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource AtencaoClara}" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RotuloFalta}" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding FaltaTexto}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Atencao}"/>
                                        <TextBlock Text="{Binding FaltaDetalhe}" Style="{StaticResource RotuloDetalhe}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PrimariaClara}" CornerRadius="10" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="Próximo pagamento" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding ProximoVencimentoTexto}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Primaria}"/>
                                        <TextBlock Text="{Binding ProximoVencimentoDetalhe}" Style="{StaticResource RotuloDetalhe}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </h:PainelAdaptavel>

                            <!-- Andamento -->
                            <Grid Margin="0,18,0,0">
                                <TextBlock Text="Andamento do pagamento" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Texto}"/>
                                <TextBlock Text="{Binding ProgressoTexto}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource Primaria}"/>
                            </Grid>
                            <ProgressBar Value="{Binding Progresso, Mode=OneWay}" Style="{StaticResource BarraMes}" Margin="0,6,0,0"/>

                            <!-- Modelo de pagamento -->
                            <TextBlock Text="Modelo de pagamento" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Texto}" Margin="0,22,0,10"/>
                            <Border BorderBrush="{StaticResource BordaSuave}" BorderThickness="1" CornerRadius="10" Padding="16,14,16,2">
                                <h:PainelAdaptavel LarguraMinima="230" EspacamentoVertical="0">
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="Modelo" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding ModeloPagamentoTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="{Binding RotuloValorParcela}" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding ValorParcelaTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="Data estimada de pagamento" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding VencimentoRegraTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="Reajuste" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding ReajusteTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="Multa por atraso" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding MultaTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding RotuloParticipacao}" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding ParticipacaoTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                </h:PainelAdaptavel>
                            </Border>

                            <!-- Lista de parcelas -->
                            <TextBlock Text="Parcelas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Texto}" Margin="0,22,0,10"/>
                            <Border BorderBrush="{StaticResource BordaSuave}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                <StackPanel>
                                    <Grid Background="{StaticResource FundoSuave}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*" MinWidth="70"/>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Nº" Style="{StaticResource CabecalhoParcela}" Margin="14,9,0,9"/>
                                        <TextBlock Grid.Column="1" Text="REFERÊNCIA" Style="{StaticResource CabecalhoParcela}" Margin="0,9"/>
                                        <TextBlock Grid.Column="2" Text="VENCIMENTO" Style="{StaticResource CabecalhoParcela}" Margin="0,9"/>
                                        <TextBlock Grid.Column="3" Text="VALOR" Style="{StaticResource CabecalhoParcela}" TextAlignment="Right" Margin="0,9,10,9"/>
                                        <TextBlock Grid.Column="4" Text="PAGO" Style="{StaticResource CabecalhoParcela}" TextAlignment="Right" Margin="0,9,10,9"/>
                                        <TextBlock Grid.Column="5" Text="PAGO EM" Style="{StaticResource CabecalhoParcela}" Margin="6,9"/>
                                        <TextBlock Grid.Column="6" Text="SITUAÇÃO" Style="{StaticResource CabecalhoParcela}" Margin="0,9,14,9"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Parcelas}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BordaSuave}" BorderThickness="0,1,0,0" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44"/>
                                                            <ColumnDefinition Width="*" MinWidth="70"/>
                                                            <ColumnDefinition Width="92"/>
                                                            <ColumnDefinition Width="105"/>
                                                            <ColumnDefinition Width="105"/>
                                                            <ColumnDefinition Width="92"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding NumeroTexto}" Style="{StaticResource CelulaParcela}" Margin="14,0,0,0"
                                                                   Foreground="{StaticResource TextoSuave}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Referencia}" Style="{StaticResource CelulaParcela}" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding VencimentoTexto}" Style="{StaticResource CelulaParcela}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding ValorPrevistoTexto}" Style="{StaticResource CelulaParcela}" TextAlignment="Right" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding ValorPagoTexto}" Style="{StaticResource CelulaParcela}" TextAlignment="Right" Margin="0,0,10,0"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource Sucesso}"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding DataPagamentoTexto}" Style="{StaticResource CelulaParcela}" Margin="6,0,0,0"/>
                                                        <Border Grid.Column="6" Style="{StaticResource PilulaPagamento}" VerticalAlignment="Center" Margin="0,0,14,0">
                                                            <TextBlock Text="{Binding PagamentoTexto}" Style="{StaticResource TextoPilulaPagamento}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Height="16"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Rodapé -->
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="26,10,26,20">
                        <Button Content="Fechar" Style="{StaticResource BotaoContorno}" Margin="0,0,10,0"
                                Command="{Binding FecharDetalheCommand}"/>
                        <Button Content="Registrar pagamento" Style="{StaticResource BotaoPrimario}"
                                Command="{Binding RegistrarDoDetalheCommand}"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ REGISTRAR PAGAMENTO (janela por cima da tela) ============ -->
        <Grid Visibility="{Binding DialogoAberto, Converter={StaticResource BoolVis}}">
            <Border Background="#99000000" MouseDown="Fundo_MouseDown"/>

            <Border Style="{StaticResource Cartao}" Background="White" MaxWidth="560" Margin="14"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="660">
                    <StackPanel Margin="26,22,26,22">

                        <TextBlock Text="Registrar pagamento" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                        <TextBlock Text="Escolha o contrato, informe o valor e confirme. Enquanto não for confirmado, o pagamento continua Pendente."
                                   FontSize="13" Foreground="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <TextBlock Text="Contrato" Style="{StaticResource Rotulo}" Margin="0,18,0,6"/>
                        <ComboBox ItemsSource="{Binding ContratosDisponiveis}" SelectedItem="{Binding ContratoSelecionado, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Codigo, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" • "/><Run Text="{Binding ImovelTitulo, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding LocatarioNome, Mode=OneWay}"/><Run Text=" ("/><Run Text="{Binding TipoTexto, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Referência (parcela pendente)" Style="{StaticResource Rotulo}" Margin="0,14,0,6"/>
                        <ComboBox ItemsSource="{Binding ParcelasDisponiveis}" SelectedItem="{Binding ParcelaSelecionada, Mode=TwoWay}"
                                  DisplayMemberPath="ParcelaTexto"/>

                        <h:PainelAdaptavel LarguraMinima="200" EspacamentoVertical="12" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Valor recebido (R$)" Style="{StaticResource Rotulo}"/>
                                <TextBox h:Mascara.Tipo="Decimal" Style="{StaticResource Campo}"
                                         Text="{Binding ValorForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Data do pagamento" Style="{StaticResource Rotulo}"/>
                                <DatePicker SelectedDate="{Binding DataPagamentoForm, Mode=TwoWay}"/>
                            </StackPanel>
                        </h:PainelAdaptavel>

                        <Border Background="#FDF3F2" CornerRadius="8" Padding="12,8" Margin="0,14,0,0"
                                Visibility="{Binding ResumoEmpresa, Converter={StaticResource TextoParaVisibilidade}}">
                            <TextBlock Text="{Binding ResumoEmpresa}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Primaria}" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Observação (opcional)" Style="{StaticResource Rotulo}" Margin="0,14,0,6"/>
                        <TextBox Style="{StaticResource Campo}" Text="{Binding ObservacaoForm, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Confirmações -->
                        <Border BorderBrush="#E6E9EE" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,16,0,0">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding ConfirmadoForm, Mode=TwoWay}" FontSize="14" FontWeight="SemiBold">
                                    <TextBlock Text="Confirmo que o pagamento foi recebido na conta" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding ErroForm}" Foreground="{StaticResource Perigo}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,12,0,0"
                                   Visibility="{Binding ErroForm, Converter={StaticResource TextoParaVisibilidade}}"/>

                        <WrapPanel HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Content="Cancelar" Style="{StaticResource BotaoContorno}" Margin="0,0,10,0"
                                    Command="{Binding FecharDialogoCommand}"/>
                            <Button Content="Registrar pagamento" Style="{StaticResource BotaoPrimario}"
                                    Command="{Binding ConfirmarRegistroCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
