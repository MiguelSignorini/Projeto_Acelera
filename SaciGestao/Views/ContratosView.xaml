<UserControl x:Class="SaciGestao.Views.ContratosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <SolidColorBrush x:Key="Vermelho" Color="#D32F2F"/>
        <SolidColorBrush x:Key="VermelhoClaro" Color="#FDEDED"/>
        <SolidColorBrush x:Key="Texto" Color="#1F2933"/>
        <SolidColorBrush x:Key="TextoSuave" Color="#5B6570"/>
        <SolidColorBrush x:Key="Borda" Color="#C9CFD8"/>

        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="TituloSecaoForm" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>

        <Style x:Key="CampoForm" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BotaoPrimario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Vermelho}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoContorno" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="White" BorderBrush="{StaticResource Borda}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoAcao" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#E4E8EE"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoAcaoPerigo" TargetType="Button" BasedOn="{StaticResource BotaoAcao}">
            <Setter Property="Background" Value="#F8D7D7"/>
            <Setter Property="Foreground" Value="{StaticResource Vermelho}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITULO DA TELA -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource Texto}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="CONTRATOS"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MostrandoFormulario}" Value="True">
                                    <Setter Property="Text" Value="{Binding TituloFormulario}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MostrandoDetalhes}" Value="True">
                                    <Setter Property="Text" Value="DETALHES DO CONTRATO"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="Gerencie os contratos formais de Locação e venda de imóveis." FontSize="14" Foreground="{StaticResource TextoSuave}" Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource BotaoPrimario}" Command="{Binding NovoCommand}" VerticalAlignment="Top" Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Novo Contrato" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- BARRA DE FILTROS (Na Lista) -->
        <Border Grid.Row="1" Style="{StaticResource Cartao}" Margin="0,18,0,0" Padding="20,16" Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel>
                <TextBlock Text="BARRA DE FILTROS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextoSuave}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Campo de Busca -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Busca (Código / Imóvel / Cliente)" Style="{StaticResource Rotulo}"/>
                        <Border Height="38" CornerRadius="8" Background="#E9ECF0">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource TextoSuave}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="14" Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- CONTEÚDO PRINCIPAL -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            
            <!-- LISTA / TABELA DE CONTRATOS -->
            <Border Style="{StaticResource Cartao}" Padding="20" Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">
                <DataGrid ItemsSource="{Binding Contratos}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="52" Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100"/>
                        <DataGridTextColumn Header="Imóvel" Binding="{Binding ImovelTitulo}" Width="1.5*"/>
                        <DataGridTextColumn Header="Inquilino / Comprador" Binding="{Binding LocatarioNome}" Width="1.5*"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="110"/>
                        <DataGridTextColumn Header="Valor Mensal" Binding="{Binding ValorMensal, StringFormat=C}" Width="130"/>
                        <DataGridTextColumn Header="Início" Binding="{Binding DataInicio, StringFormat=dd/MM/yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Término" Binding="{Binding DataFim, StringFormat=dd/MM/yyyy}" Width="110"/>
                        <DataGridTemplateColumn Header="Ações" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#xE721;" Style="{StaticResource BotaoAcao}" ToolTip="Visualizar / Gerar PDF" Command="{Binding DataContext.VisualizarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        <Button Content="&#xE70F;" Style="{StaticResource BotaoAcao}" ToolTip="Editar" Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        <Button Content="&#xE74D;" Style="{StaticResource BotaoAcaoPerigo}" ToolTip="Excluir" Command="{Binding DataContext.ExcluirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- FORMULÁRIO (NOVO / EDITAR) -->
            <Border Style="{StaticResource Cartao}" Padding="24" Visibility="{Binding MostrandoFormulario, Converter={StaticResource BoolParaVisibilidade}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="VINCULAÇÃO E IMÓVEL" Style="{StaticResource TituloSecaoForm}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Imóvel" Style="{StaticResource Rotulo}"/>
                                <ComboBox ItemsSource="{Binding ListaImoveis}" DisplayMemberPath="Titulo" SelectedValuePath="Id" SelectedValue="{Binding ContratoForm.ImovelId, Mode=TwoWay}" Height="38" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Inquilino / Comprador" Style="{StaticResource Rotulo}"/>
                                <ComboBox ItemsSource="{Binding ListaClientes}" DisplayMemberPath="Nome" SelectedValuePath="Id" SelectedValue="{Binding ContratoForm.LocatarioId, Mode=TwoWay}" Height="38" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Proprietário / Locador" Style="{StaticResource Rotulo}"/>
                                <ComboBox ItemsSource="{Binding ListaClientes}" DisplayMemberPath="Nome" SelectedValuePath="Id" SelectedValue="{Binding ContratoForm.LocadorId, Mode=TwoWay}" Height="38" FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="CONDIÇÕES FINANCEIRAS E PRAZOS" Style="{StaticResource TituloSecaoForm}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tipo" Style="{StaticResource Rotulo}"/>
                                <ComboBox ItemsSource="{Binding TiposContratoEnum}" SelectedItem="{Binding ContratoForm.Tipo, Mode=TwoWay}" Height="38" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Valor Mensal (R$)" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}" Text="{Binding ContratoForm.ValorMensal, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Prazo (Meses)" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}" Text="{Binding ContratoForm.PrazoMeses, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Dia de Vencimento" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}" Text="{Binding ContratoForm.DiaVencimento, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="PARÂMETROS JURÍDICOS E REAJUSTE" Style="{StaticResource TituloSecaoForm}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Código do Contrato" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}" Text="{Binding ContratoForm.Codigo, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data de Início" Style="{StaticResource Rotulo}"/>
                                <DatePicker SelectedDate="{Binding ContratoForm.DataInicio, Mode=TwoWay}" Height="38" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- ComboBox de Índice de Reajuste -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Índice de Reajuste" Style="{StaticResource Rotulo}"/>
                                <ComboBox SelectedItem="{Binding ContratoForm.IndiceReajuste, Mode=TwoWay}" Height="38" FontSize="14">
                                    <ComboBoxItem Content="IGP-M/FGV"/>
                                    <ComboBoxItem Content="IPCA"/>
                                    <ComboBoxItem Content="INPC"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Multa por Atraso (%)" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}" Text="{Binding ContratoForm.PercentualMultaAtraso, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Isenção Multa Rescisória (Meses)" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}" Text="{Binding ContratoForm.MesesIsencaoMultaRescisao, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Isenção Multa Rescisória (Meses)" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}" Text="{Binding ContratoForm.MesesIsencaoMultaRescisao, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Botões Rodapé -->
                        <Grid Margin="0,30,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancelar" Style="{StaticResource BotaoContorno}" Command="{Binding CancelarFormCommand}"/>
                            <Button Grid.Column="2" Content="Salvar Contrato" Style="{StaticResource BotaoPrimario}" Command="{Binding SalvarFormCommand}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- TELA DE DETALHES (VISUALIZAR) -->
            <Border Style="{StaticResource Cartao}" Padding="24" Visibility="{Binding MostrandoDetalhes, Converter={StaticResource BoolParaVisibilidade}}">
                <StackPanel DataContext="{Binding ContratoDetalhe}">
                    <TextBlock Text="DETALHES DO CONTRATO" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Texto}" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding Codigo, StringFormat='Código: {0}'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Vermelho}"/>
                    <TextBlock Text="{Binding ImovelTitulo, StringFormat='Imóvel: {0}'}" FontSize="15" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding LocatarioNome, StringFormat='Inquilino: {0}'}" FontSize="15" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ValorMensal, StringFormat='Valor Mensal: {0:C}'}" FontSize="15" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding DataInicio, StringFormat='Início da Locação: {0:dd/MM/yyyy}'}" FontSize="15" Margin="0,4,0,0"/>

                    <Grid Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Voltar" Style="{StaticResource BotaoContorno}" Command="{Binding DataContext.FecharDetalhesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Button Grid.Column="2" Content="📄 Exportar Contrato em PDF" Style="{StaticResource BotaoPrimario}" Command="{Binding DataContext.GerarPdfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>