<UserControl x:Class="SaciGestao.Views.ContratosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SaciGestao.Converters"
             xml:lang="pt-BR"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>


        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E6E9EE"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="RotuloForm" TargetType="TextBlock" BasedOn="{StaticResource Rotulo}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <Style x:Key="CampoForm" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        </Style>

        <Style x:Key="CampoFormMultilinha" TargetType="TextBox" BasedOn="{StaticResource CampoForm}">
            <Setter Property="Height" Value="70"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- ComboBox arredondado, usado nos filtros e no formulário -->
        <Style x:Key="ComboArredondado" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="White" BorderBrush="{StaticResource Borda}"
                                                BorderThickness="1" CornerRadius="8">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11" Foreground="{StaticResource TextoSuave}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="12,0,32,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0" Background="White"
                                        BorderBrush="{StaticResource Borda}" BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoPrimario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primaria}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#174A96"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoContorno" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="White" BorderBrush="{StaticResource Borda}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#F1F3F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de texto discreto (Excluir dentro do formulário) -->
        <Style x:Key="BotaoTextoPerigo" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Perigo}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{StaticResource PerigoClaro}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoAcao" TargetType="Button">
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#E4E8EE"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoAcaoPerigo" TargetType="Button" BasedOn="{StaticResource BotaoAcao}">
            <Setter Property="Background" Value="#F8D7D7"/>
            <Setter Property="Foreground" Value="{StaticResource Perigo}"/>
        </Style>

        <Style x:Key="CabecalhoColuna" TargetType="DataGridColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="White" BorderBrush="{StaticResource Primaria}"
                                BorderThickness="0,0,0,2" Padding="8,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        </Style>

        <Style x:Key="CelulaGrid" TargetType="DataGridCell">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" BorderBrush="#E3E6EB" BorderThickness="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinhaGrid" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F7F8FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextoCelula" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="EtiquetaStatus" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#E4E7EC"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Disponível">
                    <Setter Property="Background" Value="#D4EDDA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Reservado">
                    <Setter Property="Background" Value="#F5C542"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Alugado">
                    <Setter Property="Background" Value="#2F7DD1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Vendido">
                    <Setter Property="Background" Value="#1E5BB8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextoStatus" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#1F2933"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Alugado">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Vendido">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RotuloDetalhe" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ValorDetalhe" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ===== Estilos do visual novo (cards, galeria, detalhes) ===== -->
        <conv:CaminhoParaImagemConverter x:Key="CaminhoParaImagem"/>

        <Style x:Key="CartaoImovel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E6E9EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#1E5BB8"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChipImovel" TargetType="Border">
            <Setter Property="Background" Value="#F3F5F8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style x:Key="TextoChipImovel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#3D4752"/>
        </Style>

        <Style x:Key="CaixaDetalhe" TargetType="Border">
            <Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="BorderBrush" Value="#E6E9EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>

        <Style x:Key="TituloSecaoDetalhe" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <Style x:Key="IconeSecaoDetalhe" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{StaticResource PrimariaClara}"/>
        </Style>

        <Style x:Key="ChipDetalhe" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9DEE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Botão redondo semitransparente das setas da galeria -->
        <Style x:Key="BotaoSetaGaleria" TargetType="Button">
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="#99000000" CornerRadius="21">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#1E5BB8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botãozinho sobre a miniatura (capa / remover) -->
        <Style x:Key="BotaoMiniFoto" TargetType="Button">
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="#B3000000" CornerRadius="13">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#1E5BB8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Faixa de miniaturas da galeria -->
        <Style x:Key="MiniaturaGaleria" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="moldura" BorderBrush="Transparent" BorderThickness="2"
                                CornerRadius="8" Padding="1" Opacity="0.65">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="moldura" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="moldura" Property="BorderBrush" Value="#1E5BB8"/>
                                <Setter TargetName="moldura" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <conv:FiltroValorParaBoolConverter x:Key="FiltroValorParaBool"/>
        <conv:TextoAmigavelConverter x:Key="TextoAmigavel"/>
        <DataTemplate x:Key="ModeloEnumTexto">
            <TextBlock Text="{Binding Converter={StaticResource TextoAmigavel}}"/>
        </DataTemplate>

        <!-- Chip de filtro (Todos / Locações / Vendas) -->
        <Style x:Key="ChipFiltro" TargetType="RadioButton">
            <Setter Property="GroupName" Value="FiltroContrato"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="fundo" CornerRadius="8" Background="White"
                                BorderBrush="{StaticResource Borda}" BorderThickness="1" Padding="16,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#F1F3F6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fundo" Property="BorderBrush" Value="{StaticResource Primaria}"/>
                                <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Etiqueta de status do contrato -->
        <Style x:Key="EtiquetaContrato" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#E4E7EC"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ativo">
                    <Setter Property="Background" Value="#D4EDDA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelado">
                    <Setter Property="Background" Value="#FBDADA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextoEtiquetaContrato" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ativo">
                    <Setter Property="Foreground" Value="#14532D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelado">
                    <Setter Property="Foreground" Value="#8B1A1A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Cartão de indicador (números do topo) -->
        <Style x:Key="CartaoIndicador" TargetType="Border" BasedOn="{StaticResource Cartao}">
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style x:Key="NumeroIndicador" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        </Style>

        <Style x:Key="TituloSecaoForm" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
            <Setter Property="Margin" Value="0,22,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ TÍTULO ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource Texto}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="CONTRATOS"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MostrandoFormulario}" Value="True">
                                    <Setter Property="Text" Value="{Binding TituloFormulario}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MostrandoDetalhes}" Value="True">
                                    <Setter Property="Text" Value="Detalhes do contrato"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="Gerencie os contratos de locação e venda de imóveis."
                           FontSize="14" Foreground="{StaticResource TextoSuave}"
                           Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource BotaoPrimario}" Command="{Binding NovoCommand}"
                    VerticalAlignment="Top"
                    Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Novo Contrato" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ============ INDICADORES + FILTROS (só na lista) ============ -->
        <StackPanel Grid.Row="1" Margin="0,18,0,0"
                    Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">

            <UniformGrid Columns="4">
                <Border Style="{StaticResource CartaoIndicador}">
                    <StackPanel>
                        <TextBlock Text="CONTRATOS ATIVOS" Style="{StaticResource RotuloDetalhe}"/>
                        <TextBlock Text="{Binding TotalAtivos}" Style="{StaticResource NumeroIndicador}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CartaoIndicador}">
                    <StackPanel>
                        <TextBlock Text="LOCAÇÕES" Style="{StaticResource RotuloDetalhe}"/>
                        <TextBlock Text="{Binding TotalLocacao}" Style="{StaticResource NumeroIndicador}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CartaoIndicador}">
                    <StackPanel>
                        <TextBlock Text="VENDAS" Style="{StaticResource RotuloDetalhe}"/>
                        <TextBlock Text="{Binding TotalVenda}" Style="{StaticResource NumeroIndicador}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CartaoIndicador}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="RECEITA MENSAL (LOCAÇÕES)" Style="{StaticResource RotuloDetalhe}"/>
                        <TextBlock Text="{Binding ReceitaMensal, StringFormat=C0}" Style="{StaticResource NumeroIndicador}"
                                   Foreground="{StaticResource Primaria}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Cartao}" Margin="0,16,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Height="40" CornerRadius="8" Background="#E9ECF0">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{StaticResource TextoSuave}" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1" Margin="10,0,0,0">
                                <TextBox x:Name="txtBusca" BorderThickness="0" Background="Transparent"
                                         FontSize="14" VerticalContentAlignment="Center"
                                         Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Buscar por código, imóvel ou cliente..."
                                           Foreground="#5F6B7A" FontSize="14" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="2,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtBusca}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <RadioButton Content="Todos" Style="{StaticResource ChipFiltro}"
                                     IsChecked="{Binding FiltroTipo, Mode=TwoWay, Converter={StaticResource FiltroValorParaBool}, ConverterParameter=Todos}"/>
                        <RadioButton Content="Locações" Style="{StaticResource ChipFiltro}"
                                     IsChecked="{Binding FiltroTipo, Mode=TwoWay, Converter={StaticResource FiltroValorParaBool}, ConverterParameter=Locacao}"/>
                        <RadioButton Content="Vendas" Style="{StaticResource ChipFiltro}" Margin="0"
                                     IsChecked="{Binding FiltroTipo, Mode=TwoWay, Converter={StaticResource FiltroValorParaBool}, ConverterParameter=Venda}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ============ CONTEÚDO: lista OU formulário OU detalhes ============ -->
        <Grid Grid.Row="2" Margin="0,16,0,0">

            <!-- LISTA -->
            <Border Style="{StaticResource Cartao}" Padding="20,8"
                    Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Contratos}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeaderWidth="0" RowHeight="58"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              Background="Transparent" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource CabecalhoColuna}"
                              CellStyle="{StaticResource CelulaGrid}"
                              RowStyle="{StaticResource LinhaGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="90"
                                                ElementStyle="{StaticResource TextoCelula}"/>

                            <DataGridTemplateColumn Header="Imóvel" Width="1.5*" MinWidth="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ImovelTitulo}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Texto}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding LocadorNome, StringFormat='Proprietário: {0}'}" FontSize="12"
                                                       Foreground="{StaticResource TextoSuave}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Inquilino / Comprador" Binding="{Binding LocatarioNome}" Width="1.3*" MinWidth="150"
                                                ElementStyle="{StaticResource TextoCelula}"/>

                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoTexto}" Width="90"
                                                ElementStyle="{StaticResource TextoCelula}"/>

                            <DataGridTextColumn Header="Valor" Binding="{Binding ValorTexto}" Width="140"
                                                ElementStyle="{StaticResource TextoCelula}"/>

                            <DataGridTextColumn Header="Período" Binding="{Binding PeriodoTexto}" Width="1.1*" MinWidth="170"
                                                ElementStyle="{StaticResource TextoCelula}"/>

                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource EtiquetaContrato}" Margin="8,0">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource TextoEtiquetaContrato}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Ações" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                            <Button Content="&#xE721;" ToolTip="Visualizar / gerar PDF" Style="{StaticResource BotaoAcao}"
                                                    Command="{Binding DataContext.VisualizarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="&#xE70F;" ToolTip="Editar" Style="{StaticResource BotaoAcao}"
                                                    Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="&#xE74D;" ToolTip="Excluir" Style="{StaticResource BotaoAcaoPerigo}"
                                                    Command="{Binding DataContext.ExcluirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Nenhum contrato encontrado."
                               Foreground="{StaticResource TextoSuave}" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Contratos.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- FORMULÁRIO (novo / editar) -->
            <Border Style="{StaticResource Cartao}" MaxWidth="1180" HorizontalAlignment="Stretch"
                    Visibility="{Binding MostrandoFormulario, Converter={StaticResource BoolParaVisibilidade}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22,28,26">

                        <TextBlock Text="VINCULAÇÃO" Style="{StaticResource TituloSecaoForm}" Margin="0"/>
                        <Border BorderBrush="#E6E9EE" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Imóvel" Style="{StaticResource RotuloForm}"/>
                                <ComboBox Style="{StaticResource ComboArredondado}" ItemsSource="{Binding ListaImoveis}"
                                          DisplayMemberPath="Titulo" SelectedValuePath="Id"
                                          SelectedValue="{Binding ImovelIdSelecionado, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Inquilino / Comprador" Style="{StaticResource RotuloForm}"/>
                                <ComboBox Style="{StaticResource ComboArredondado}" ItemsSource="{Binding ListaLocatarios}"
                                          DisplayMemberPath="Nome" SelectedValuePath="Id"
                                          SelectedValue="{Binding ContratoForm.LocatarioId, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Proprietário / Locador" Style="{StaticResource RotuloForm}"/>
                                <ComboBox Style="{StaticResource ComboArredondado}" ItemsSource="{Binding ListaLocadores}"
                                          DisplayMemberPath="Nome" SelectedValuePath="Id"
                                          SelectedValue="{Binding ContratoForm.LocadorId, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="CONDIÇÕES FINANCEIRAS" Style="{StaticResource TituloSecaoForm}"/>
                        <Border BorderBrush="#E6E9EE" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tipo" Style="{StaticResource RotuloForm}"/>
                                <!-- ALTERAÇÃO 1: Usa TipoSelecionadoForm para disparar a visibilidade do reajuste -->
                                <ComboBox Style="{StaticResource ComboArredondado}" ItemsSource="{Binding TiposContratoEnum}" ItemTemplate="{StaticResource ModeloEnumTexto}"
                                          SelectedItem="{Binding TipoSelecionadoForm, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Status" Style="{StaticResource RotuloForm}"/>
                                <ComboBox Style="{StaticResource ComboArredondado}" ItemsSource="{Binding StatusesContratoEnum}"
                                          SelectedItem="{Binding ContratoForm.Status, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Valor (R$)" Style="{StaticResource RotuloForm}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding ContratoForm.ValorMensal, StringFormat=N2}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Prazo (meses)" Style="{StaticResource RotuloForm}"/>
                                <TextBox Style="{StaticResource CampoForm}" Text="{Binding ContratoForm.PrazoMeses}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="Dia de vencimento" Style="{StaticResource RotuloForm}"/>
                                <TextBox Style="{StaticResource CampoForm}" Text="{Binding ContratoForm.DiaVencimento}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="DATAS E REAJUSTE" Style="{StaticResource TituloSecaoForm}"/>
                        <Border BorderBrush="#E6E9EE" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Data de início" Style="{StaticResource RotuloForm}"/>
                                <DatePicker SelectedDate="{Binding ContratoForm.DataInicio, Mode=TwoWay}" Height="40"
                                            VerticalContentAlignment="Center" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data de assinatura" Style="{StaticResource RotuloForm}"/>
                                <DatePicker SelectedDate="{Binding ContratoForm.DataAssinatura, Mode=TwoWay}" Height="40"
                                            VerticalContentAlignment="Center" FontSize="14"/>
                            </StackPanel>

                            <!-- ALTERAÇÃO 2: Envolvido em StackPanel com visibilidade baseada em MostrarIndiceReajuste -->
                            <StackPanel Grid.Column="4" Visibility="{Binding MostrarIndiceReajuste, Converter={StaticResource BoolParaVisibilidade}}">
                                <TextBlock Text="Índice de reajuste" Style="{StaticResource RotuloForm}"/>
                                <ComboBox Style="{StaticResource ComboArredondado}" ItemsSource="{Binding IndicesReajuste}"
                                          SelectedItem="{Binding ContratoForm.IndiceReajuste, Mode=TwoWay}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Multa por atraso (%)" Style="{StaticResource RotuloForm}"/>
                                <TextBox Style="{StaticResource CampoForm}" Text="{Binding ContratoForm.PercentualMultaAtraso}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="Isenção de multa rescisória (meses)" Style="{StaticResource RotuloForm}"/>
                                <TextBox Style="{StaticResource CampoForm}" Text="{Binding ContratoForm.MesesIsencaoMultaRescisao}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="A data de término é calculada automaticamente (início + prazo)."
                                   FontSize="12" Foreground="{StaticResource TextoSuave}" Margin="0,8,0,0"/>

                        <TextBlock Text="CONCESSIONÁRIAS" Style="{StaticResource TituloSecaoForm}"/>
                        <Border BorderBrush="#E6E9EE" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Unidade consumidora - Energia (EDP)" Style="{StaticResource RotuloForm}"/>
                                <TextBox Style="{StaticResource CampoForm}" Text="{Binding ContratoForm.UC_Energia}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Unidade consumidora - Água (Sabesp)" Style="{StaticResource RotuloForm}"/>
                                <TextBox Style="{StaticResource CampoForm}" Text="{Binding ContratoForm.UC_Agua}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="OBSERVAÇÕES" Style="{StaticResource TituloSecaoForm}"/>
                        <Border BorderBrush="#E6E9EE" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>
                        <TextBox Style="{StaticResource CampoFormMultilinha}" Text="{Binding ContratoForm.Observacoes}"/>

                        <TextBlock Text="{Binding ErroForm}" Foreground="{StaticResource Perigo}" FontSize="13"
                                   Margin="0,14,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErroForm}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancelar" Style="{StaticResource BotaoContorno}"
                                    Command="{Binding CancelarFormCommand}"/>
                            <Button Grid.Column="2" Content="Salvar Contrato" Style="{StaticResource BotaoPrimario}"
                                    Command="{Binding SalvarFormCommand}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- DETALHES -->
            <Border Style="{StaticResource Cartao}" MaxWidth="1180" HorizontalAlignment="Stretch"
                    Visibility="{Binding MostrandoDetalhes, Converter={StaticResource BoolParaVisibilidade}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" DataContext="{Binding ContratoDetalhe}"
                            Background="#F7F8FA" CornerRadius="12,12,0,0"
                            BorderBrush="#E6E9EE" BorderThickness="0,0,0,1" Padding="28,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ImovelTitulo}" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource Texto}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ValorTexto}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource Primaria}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource ChipDetalhe}">
                                    <TextBlock Text="{Binding Codigo}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Texto}"/>
                                </Border>
                                <Border Style="{StaticResource ChipDetalhe}">
                                    <TextBlock Text="{Binding TipoTexto}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Texto}"/>
                                </Border>
                                <Border Style="{StaticResource EtiquetaContrato}" Padding="14,4">
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource TextoEtiquetaContrato}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" DataContext="{Binding ContratoDetalhe}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24,28,16">

                            <!-- Partes -->
                            <StackPanel Margin="0,0,0,22">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource IconeSecaoDetalhe}">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource Primaria}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="PARTES" Style="{StaticResource TituloSecaoDetalhe}"/>
                                </StackPanel>
                                <Border Style="{StaticResource CaixaDetalhe}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Proprietário / Locador" Style="{StaticResource RotuloDetalhe}"/>
                                            <TextBlock Text="{Binding LocadorNome}" Style="{StaticResource ValorDetalhe}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Inquilino / Comprador" Style="{StaticResource RotuloDetalhe}"/>
                                            <TextBlock Text="{Binding LocatarioNome}" Style="{StaticResource ValorDetalhe}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Prazos -->
                            <StackPanel Margin="0,0,0,22">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource IconeSecaoDetalhe}">
                                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource Primaria}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="PRAZOS" Style="{StaticResource TituloSecaoDetalhe}"/>
                                </StackPanel>
                                <Border Style="{StaticResource CaixaDetalhe}">
                                    <UniformGrid Columns="4">
                                        <StackPanel>
                                            <TextBlock Text="Início" Style="{StaticResource RotuloDetalhe}"/>
                                            <TextBlock Text="{Binding DataInicio, StringFormat=dd/MM/yyyy}" Style="{StaticResource ValorDetalhe}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Término" Style="{StaticResource RotuloDetalhe}"/>
                                            <TextBlock Text="{Binding DataFim, StringFormat=dd/MM/yyyy}" Style="{StaticResource ValorDetalhe}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Assinatura" Style="{StaticResource RotuloDetalhe}"/>
                                            <TextBlock Text="{Binding DataAssinatura, StringFormat=dd/MM/yyyy}" Style="{StaticResource ValorDetalhe}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Vencimento / prazo" Style="{StaticResource RotuloDetalhe}"/>
                                            <TextBlock Style="{StaticResource ValorDetalhe}">
                                                <Run Text="dia "/><Run Text="{Binding DiaVencimento, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding PrazoMeses, Mode=OneWay}"/><Run Text=" meses"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <!-- Condições -->
                            <StackPanel Margin="0,0,0,22">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource IconeSecaoDetalhe}">
                                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource Primaria}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="CONDIÇÕES" Style="{StaticResource TituloSecaoDetalhe}"/>
                                </StackPanel>
                                <Border Style="{StaticResource CaixaDetalhe}">
                                    <UniformGrid Columns="3">
                                        <StackPanel>
                                            <TextBlock Text="Índice de reajuste" Style="{StaticResource RotuloDetalhe}"/>
                                            <TextBlock Text="{Binding IndiceReajuste}" Style="{StaticResource ValorDetalhe}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Multa por atraso" Style="{StaticResource RotuloDetalhe}"/>
                                            <TextBlock Text="{Binding PercentualMultaAtraso, StringFormat='{}{0}%'}" Style="{StaticResource ValorDetalhe}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Isenção de multa rescisória" Style="{StaticResource RotuloDetalhe}"/>
                                            <TextBlock Text="{Binding MesesIsencaoMultaRescisao, StringFormat='{}{0} meses'}" Style="{StaticResource ValorDetalhe}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <!-- Concessionárias + observações -->
                            <StackPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource IconeSecaoDetalhe}">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource Primaria}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="CONCESSIONÁRIAS E OBSERVAÇÕES" Style="{StaticResource TituloSecaoDetalhe}"/>
                                </StackPanel>
                                <Border Style="{StaticResource CaixaDetalhe}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="UC energia (EDP)" Style="{StaticResource RotuloDetalhe}"/>
                                                <TextBlock Text="{Binding UcEnergiaTexto}" Style="{StaticResource ValorDetalhe}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="UC água (Sabesp)" Style="{StaticResource RotuloDetalhe}"/>
                                                <TextBlock Text="{Binding UcAguaTexto}" Style="{StaticResource ValorDetalhe}"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Margin="0,16,0,0">
                                            <TextBlock Text="Observações" Style="{StaticResource RotuloDetalhe}"/>
                                            <TextBlock Text="{Binding ObservacoesTexto}" Style="{StaticResource ValorDetalhe}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="28,8,28,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource BotaoContorno}" Command="{Binding FecharDetalhesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Voltar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource BotaoPrimario}" Command="{Binding GerarPdfCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Exportar contrato em PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>