<Window x:Class="SaciGestao.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaciGestao - Entrar"
        Width="1000" Height="640" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>

        <SolidColorBrush x:Key="CorMenu" Color="#222B33"/>
        <SolidColorBrush x:Key="Vermelho" Color="#D32F2F"/>
        <SolidColorBrush x:Key="VermelhoClaro" Color="#FDEDED"/>
        <SolidColorBrush x:Key="Texto" Color="#1F2933"/>
        <SolidColorBrush x:Key="TextoSuave" Color="#5B6570"/>
        <SolidColorBrush x:Key="Borda" Color="#C9CFD8"/>

        <Style x:Key="RotuloForm" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <Style x:Key="CampoForm" TargetType="Control">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource CampoForm}">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        </Style>

        <Style TargetType="PasswordBox" BasedOn="{StaticResource CampoForm}">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        </Style>

        <Style x:Key="BotaoPrimario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Vermelho}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoContorno" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="White" BorderBrush="{StaticResource Borda}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#F1F3F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkTexto" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Vermelho}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextoErro" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Vermelho}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextoSucesso" TargetType="TextBlock" BasedOn="{StaticResource TextoErro}">
            <Setter Property="Foreground" Value="#2E7D32"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lado esquerdo: identidade visual, mesma cor do menu do sistema -->
        <Border Grid.Column="0" Background="{StaticResource CorMenu}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                <TextBlock Text="S+I" FontSize="64" FontWeight="Bold"
                           Foreground="{StaticResource Vermelho}" HorizontalAlignment="Center"/>
                <TextBlock Text="SACILOTTI" FontSize="26" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="EMPREENDIMENTOS IMOBILIÁRIOS" FontSize="12"
                           Foreground="#AEB7C2" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Text="Sistema de gestão da imobiliária" FontSize="13"
                           Foreground="#AEB7C2" HorizontalAlignment="Center" Margin="0,30,0,0"/>
            </StackPanel>
        </Border>

        <!-- Lado direito: formulário de login ou recuperação -->
        <Grid Grid.Column="1" Background="White">

            <!-- Sair: fecha o programa sem precisar entrar. Fica fixo no canto,
                 visível tanto na tela de login quanto na de recuperar senha. -->
            <Button Content="Sair do sistema" Click="Sair_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24"
                    Foreground="{StaticResource Texto}" FontSize="13" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="Transparent" CornerRadius="6" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#F1F3F6"/>
                                <Setter Property="Foreground" Value="{StaticResource Vermelho}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- LOGIN -->
            <StackPanel VerticalAlignment="Center" Margin="60">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoRecuperar}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MostrandoRecuperar}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Bem-vindo de volta" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource Texto}"/>
                <TextBlock Text="Entre com seu usuário e senha para acessar o sistema." FontSize="14"
                           Foreground="{StaticResource TextoSuave}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="Usuário" Style="{StaticResource RotuloForm}"/>
                <TextBox x:Name="txtUsuarioLogin"
                         Text="{Binding NomeUsuarioLogin, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Senha" Style="{StaticResource RotuloForm}"/>
                <PasswordBox x:Name="txtSenhaLogin" PasswordChanged="SenhaLogin_PasswordChanged"/>

                <Button Content="Esqueci minha senha" Style="{StaticResource LinkTexto}"
                        Command="{Binding AbrirRecuperarCommand}" Margin="0,10,0,0"/>

                <Button Content="Entrar" Style="{StaticResource BotaoPrimario}"
                        Command="{Binding EntrarCommand}" Margin="0,16,0,0"/>

                <TextBlock Text="{Binding ErroLogin}" Style="{StaticResource TextoErro}"/>

                <TextBlock Text="Usuário de teste: admin   |   Senha: 123" FontSize="12"
                           Foreground="{StaticResource TextoSuave}" Margin="0,24,0,0"/>
            </StackPanel>

            <!-- RECUPERAR SENHA -->
            <StackPanel VerticalAlignment="Center" Margin="60"
                        Visibility="{Binding MostrandoRecuperar, Converter={StaticResource BoolParaVisibilidade}}">

                <TextBlock Text="Recuperar senha" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource Texto}"/>
                <TextBlock Text="Como não há e-mail cadastrado, a recuperação é feita pela pergunta secreta."
                           FontSize="13" Foreground="{StaticResource TextoSuave}"
                           Margin="0,6,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="Usuário" Style="{StaticResource RotuloForm}"/>
                <TextBox Text="{Binding RecNomeUsuario, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Passo 1: continuar sem ter revelado a pergunta ainda -->
                <Button Content="Continuar"
                        Command="{Binding ContinuarRecuperarCommand}" Margin="0,14,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotaoContorno}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PerguntaRevelada}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Passo 2: pergunta + resposta + nova senha, só depois de revelada -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PerguntaRevelada}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Background="#F1F3F6" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                        <TextBlock Text="{Binding PerguntaTexto}" FontSize="14" FontStyle="Italic"
                                   Foreground="{StaticResource Texto}" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Resposta" Style="{StaticResource RotuloForm}"/>
                    <TextBox Text="{Binding RecResposta, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Nova senha" Style="{StaticResource RotuloForm}"/>
                    <PasswordBox x:Name="txtNovaSenha" PasswordChanged="NovaSenha_PasswordChanged"/>

                    <TextBlock Text="Confirmar nova senha" Style="{StaticResource RotuloForm}"/>
                    <PasswordBox x:Name="txtConfirmarSenha" PasswordChanged="ConfirmarSenha_PasswordChanged"/>

                    <Button Content="Redefinir senha" Style="{StaticResource BotaoPrimario}"
                            Command="{Binding RedefinirSenhaCommand}" Margin="0,16,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding ErroRecuperar}" Style="{StaticResource TextoErro}"/>
                <TextBlock Text="{Binding SucessoRecuperar}" Style="{StaticResource TextoSucesso}"/>

                <Button Content="← Voltar para o login" Style="{StaticResource LinkTexto}"
                        Command="{Binding VoltarLoginCommand}"
                        HorizontalAlignment="Left" Margin="0,20,0,0"/>

            </StackPanel>

        </Grid>
    </Grid>
</Window>
