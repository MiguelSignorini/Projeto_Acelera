<Window x:Class="SaciGestao.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaciGestao - Entrar"
        Width="1080" Height="680" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        xml:lang="pt-BR"
        FontFamily="Segoe UI">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>


        <Style x:Key="RotuloForm" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>

        <!-- Campo de texto arredondado com ícone à esquerda (o ícone vem da propriedade Tag) -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="moldura" Background="#F6F7F9" BorderBrush="{StaticResource Borda}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="#5F6B7A" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="10,0,12,0"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="moldura" Property="BorderBrush" Value="{StaticResource Primaria}"/>
                                <Setter TargetName="moldura" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="moldura" Background="#F6F7F9" BorderBrush="{StaticResource Borda}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="#5F6B7A" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="10,0,12,0"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="moldura" Property="BorderBrush" Value="{StaticResource Primaria}"/>
                                <Setter TargetName="moldura" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoPrimario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primaria}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#174A96"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoContorno" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="White" BorderBrush="{StaticResource Borda}"
                                BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#F1F3F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkTexto" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextoErro" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Perigo}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextoSucesso" TargetType="TextBlock" BasedOn="{StaticResource TextoErro}">
            <Setter Property="Foreground" Value="#2E7D32"/>
        </Style>

        <!-- Itens da lista de destaques do painel esquerdo -->
        <Style x:Key="IconeDestaque" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#33D32F2F"/>
            <Setter Property="BorderBrush" Value="#66D32F2F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="TituloDestaque" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="TextoDestaque" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#9AA6B2"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ LADO ESQUERDO: identidade visual ============ -->
        <Border Grid.Column="0" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#161C22" Offset="0"/>
                    <GradientStop Color="#222B33" Offset="0.6"/>
                    <GradientStop Color="#2E3A45" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <!-- Círculos decorativos -->
                <Ellipse Width="460" Height="460" Fill="#14D32F2F" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-190,-170,0,0"/>
                <Ellipse Width="320" Height="320" Fill="#0FFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-120,-110"/>
                <Ellipse Width="140" Height="140" Stroke="#26FFFFFF" StrokeThickness="1.5"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,60,0"/>

                <StackPanel VerticalAlignment="Center" Margin="64,40">
                    <Image Source="/Resources/logo3.png" Width="230" HorizontalAlignment="Left"/>

                    <TextBlock Text="Gestão imobiliária&#x0A;simples e completa." FontSize="32" FontWeight="Bold"
                               Foreground="White" Margin="0,34,0,0" LineHeight="40"/>
                    <TextBlock Text="Imóveis, clientes e contratos em um só lugar."
                               FontSize="14.5" Foreground="#AEB7C2" Margin="0,10,0,0"/>

                    <StackPanel Margin="0,36,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Style="{StaticResource IconeDestaque}">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                           Foreground="#8DBBF7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Catálogo de imóveis" Style="{StaticResource TituloDestaque}"/>
                                <TextBlock Text="Fotos, valores, endereços e status sempre à mão." Style="{StaticResource TextoDestaque}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Style="{StaticResource IconeDestaque}">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                           Foreground="#8DBBF7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Carteira de clientes" Style="{StaticResource TituloDestaque}"/>
                                <TextBlock Text="Proprietários, compradores e inquilinos organizados." Style="{StaticResource TextoDestaque}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconeDestaque}">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                           Foreground="#8DBBF7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Contratos em PDF" Style="{StaticResource TituloDestaque}"/>
                                <TextBlock Text="Locação e venda com geração automática do documento." Style="{StaticResource TextoDestaque}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="© Sacilotti Empreendimentos Imobiliários" FontSize="11.5" Foreground="#9AA6B2"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="64,0,0,24"/>
            </Grid>
        </Border>

        <!-- ============ LADO DIREITO: login / recuperação ============ -->
        <Grid Grid.Column="1" Background="White">

            <Button Content="Sair do sistema" Click="Sair_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24"
                    Foreground="{StaticResource Texto}" FontSize="13" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="Transparent" CornerRadius="6" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#F1F3F6"/>
                                <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- LOGIN -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Margin="30">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoRecuperar}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MostrandoRecuperar}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource PrimariaClara}"
                        HorizontalAlignment="Left">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="{StaticResource Primaria}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Bem-vindo de volta" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource Texto}" Margin="0,18,0,0"/>
                <TextBlock Text="Entre com seu usuário e senha para acessar o sistema." FontSize="14"
                           Foreground="{StaticResource TextoSuave}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="Usuário" Style="{StaticResource RotuloForm}" Margin="0,26,0,6"/>
                <TextBox x:Name="txtUsuarioLogin" Tag="&#xE77B;"
                         Text="{Binding NomeUsuarioLogin, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Senha" Style="{StaticResource RotuloForm}"/>
                <PasswordBox x:Name="txtSenhaLogin" Tag="&#xE72E;" PasswordChanged="SenhaLogin_PasswordChanged"/>

                <Button Content="Esqueci minha senha" Style="{StaticResource LinkTexto}"
                        Command="{Binding AbrirRecuperarCommand}" Margin="0,12,0,0"/>

                <Button Style="{StaticResource BotaoPrimario}" IsDefault="True"
                        Command="{Binding EntrarCommand}" Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Entrar" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Margin="10,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding ErroLogin}" Style="{StaticResource TextoErro}"/>

                <Border Background="#F6F7F9" CornerRadius="8" Padding="14,10" Margin="0,26,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#5F6B7A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Usuário de teste: admin   |   Senha: 123" FontSize="12.5"
                                   Foreground="{StaticResource TextoSuave}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RECUPERAR SENHA -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Margin="30"
                        Visibility="{Binding MostrandoRecuperar, Converter={StaticResource BoolParaVisibilidade}}">

                <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource PrimariaClara}"
                        HorizontalAlignment="Left">
                    <TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="{StaticResource Primaria}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Recuperar senha" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource Texto}" Margin="0,18,0,0"/>
                <TextBlock Text="Como não há e-mail cadastrado, a recuperação é feita pela pergunta secreta."
                           FontSize="13.5" Foreground="{StaticResource TextoSuave}"
                           Margin="0,6,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="Usuário" Style="{StaticResource RotuloForm}" Margin="0,22,0,6"/>
                <TextBox Tag="&#xE77B;" Text="{Binding RecNomeUsuario, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Passo 1 -->
                <Button Content="Continuar"
                        Command="{Binding ContinuarRecuperarCommand}" Margin="0,16,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotaoContorno}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PerguntaRevelada}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Passo 2 -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PerguntaRevelada}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Background="#F6F7F9" CornerRadius="10" Padding="14" Margin="0,16,0,0">
                        <TextBlock Text="{Binding PerguntaTexto}" FontSize="14" FontStyle="Italic"
                                   Foreground="{StaticResource Texto}" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Resposta" Style="{StaticResource RotuloForm}"/>
                    <TextBox Tag="&#xE897;" Text="{Binding RecResposta, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Nova senha" Style="{StaticResource RotuloForm}"/>
                    <PasswordBox x:Name="txtNovaSenha" Tag="&#xE72E;" PasswordChanged="NovaSenha_PasswordChanged"/>

                    <TextBlock Text="Confirmar nova senha" Style="{StaticResource RotuloForm}"/>
                    <PasswordBox x:Name="txtConfirmarSenha" Tag="&#xE72E;" PasswordChanged="ConfirmarSenha_PasswordChanged"/>

                    <Button Content="Redefinir senha" Style="{StaticResource BotaoPrimario}"
                            Command="{Binding RedefinirSenhaCommand}" Margin="0,18,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding ErroRecuperar}" Style="{StaticResource TextoErro}"/>
                <TextBlock Text="{Binding SucessoRecuperar}" Style="{StaticResource TextoSucesso}"/>

                <Button Content="← Voltar para o login" Style="{StaticResource LinkTexto}"
                        Command="{Binding VoltarLoginCommand}"
                        HorizontalAlignment="Left" Margin="0,20,0,0"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
