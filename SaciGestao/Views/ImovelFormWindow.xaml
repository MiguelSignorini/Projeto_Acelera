<Window x:Class="SaciGestao.Views.ImovelFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imóvel" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#F1F3F6" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2933"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BotaoForm" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="26,20,26,24">

        <TextBlock x:Name="txtCabecalho" Text="Imóvel" FontSize="22" FontWeight="Bold"
                   Foreground="#1F2933"/>

        <TextBlock Text="Título" Style="{StaticResource Rotulo}"/>
        <TextBox x:Name="txtTitulo"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Tipo" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="cbTipo"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Finalidade" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="cbFinalidade"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Status" Style="{StaticResource Rotulo}"/>
        <ComboBox x:Name="cbStatus"/>

        <TextBlock Text="Endereço" Style="{StaticResource Rotulo}"/>
        <TextBox x:Name="txtEndereco"/>

        <TextBlock Text="Bairro" Style="{StaticResource Rotulo}"/>
        <TextBox x:Name="txtBairro"/>

        <TextBlock Text="Valor (R$)" Style="{StaticResource Rotulo}"/>
        <TextBox x:Name="txtValor"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Quartos" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="txtQuartos"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Vagas" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="txtVagas"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="txtErro" Foreground="#D32F2F" FontSize="13"
                   TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotaoForm}"
                    IsCancel="True" Click="Cancelar_Click"/>
            <Button Content="Salvar" Style="{StaticResource BotaoForm}"
                    Background="#D32F2F" Foreground="White" BorderBrush="#D32F2F"
                    IsDefault="True" Click="Salvar_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
