<UserControl x:Class="SaciGestao.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SaciGestao.Converters"
             xml:lang="pt-BR"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <conv:FiltroValorParaBoolConverter x:Key="FiltroValorParaBool"/>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>


        <!-- Cartão branco -->
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E6E9EE"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Título de cada seção do formulário (DADOS PESSOAIS / CONTATO / ...) -->
        <Style x:Key="TituloSecaoForm" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
            <Setter Property="Margin" Value="0,22,0,10"/>
        </Style>

        <!-- Campos de texto do formulário -->
        <Style x:Key="CampoForm" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DataPickerForm" TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBox arredondado, usado nos filtros e no formulário -->
        <Style x:Key="ComboArredondado" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="White" BorderBrush="{StaticResource Borda}"
                                                BorderThickness="1" CornerRadius="8">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11" Foreground="{StaticResource TextoSuave}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="12,0,32,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0" Background="White"
                                        BorderBrush="{StaticResource Borda}" BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão vermelho (Novo Cliente / Salvar Cliente) -->
        <Style x:Key="BotaoPrimario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primaria}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#174A96"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão contornado (Cancelar) -->
        <Style x:Key="BotaoContorno" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="White" BorderBrush="{StaticResource Borda}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#F1F3F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de texto discreto (Excluir dentro do formulário) -->
        <Style x:Key="BotaoTextoPerigo" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Perigo}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{StaticResource PerigoClaro}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip de filtro (Todos / Proprietários / Compradores / Inquilinos) -->
        <Style x:Key="ChipFiltro" TargetType="RadioButton">
            <Setter Property="GroupName" Value="FiltroTipo"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="fundo" CornerRadius="8" Background="White"
                                BorderBrush="{StaticResource Borda}" BorderThickness="1"
                                Padding="16,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#F1F3F6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fundo" Property="BorderBrush" Value="{StaticResource Primaria}"/>
                                <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BadgeContagem" TargetType="Border">
            <Setter Property="Background" Value="#E4E8EE"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="TextoBadge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        </Style>

        <!-- Botões de ação da tabela -->
        <Style x:Key="BotaoAcao" TargetType="Button">
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#E4E8EE"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoAcaoPerigo" TargetType="Button" BasedOn="{StaticResource BotaoAcao}">
            <Setter Property="Background" Value="#F8D7D7"/>
            <Setter Property="Foreground" Value="{StaticResource Perigo}"/>
        </Style>

        <!-- Botão Excluir da linha: aparece para qualquer status -->
        <Style x:Key="BotaoExcluirLinha" TargetType="Button" BasedOn="{StaticResource BotaoAcaoPerigo}"/>

        <!-- Estilo da tabela -->
        <Style x:Key="CabecalhoColuna" TargetType="DataGridColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="White" BorderBrush="{StaticResource Primaria}"
                                BorderThickness="0,0,0,2" Padding="8,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        </Style>

        <Style x:Key="CelulaGrid" TargetType="DataGridCell">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" BorderBrush="#E3E6EB" BorderThickness="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinhaGrid" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F7F8FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextoCelula" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Ponto e texto coloridos do status -->
        <Style x:Key="PontoStatus" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Fill" Value="#5F6B7A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ativo">
                    <Setter Property="Fill" Value="#3F9142"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="EmAtendimento">
                    <Setter Property="Fill" Value="#F5C542"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Inativo">
                    <Setter Property="Fill" Value="{StaticResource Primaria}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextoStatusCliente" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ativo">
                    <Setter Property="Foreground" Value="#3F9142"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="EmAtendimento">
                    <Setter Property="Foreground" Value="#B8860B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Inativo">
                    <Setter Property="Foreground" Value="{StaticResource Primaria}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Tela de detalhes do cliente ===== -->
        <Style x:Key="RotuloDetalhe" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Valor do campo; quando vazio fica cinza e em itálico -->
        <Style x:Key="ValorDetalhe" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Não informado">
                    <Setter Property="Foreground" Value="#5F6B7A"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CaixaDetalhe" TargetType="Border">
            <Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="BorderBrush" Value="#E6E9EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>

        <Style x:Key="TituloSecaoDetalhe" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <Style x:Key="IconeSecaoDetalhe" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{StaticResource PrimariaClara}"/>
        </Style>

        <Style x:Key="ChipDetalhe" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9DEE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ TÍTULO ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource Texto}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="CLIENTES"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MostrandoFormulario}" Value="True">
                                    <Setter Property="Text" Value="{Binding TituloFormulario}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MostrandoDetalhes}" Value="True">
                                    <Setter Property="Text" Value="DETALHES DO CLIENTE"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="Gerencie os clientes e pessoas relacionadas aos imóveis."
                           FontSize="14" Foreground="{StaticResource TextoSuave}"
                           Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}"/>
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource BotaoPrimario}"
                    Command="{Binding NovoCommand}" VerticalAlignment="Top"
                    Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Novo Cliente" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ============ FILTROS: só na lista ============ -->
        <Border Grid.Row="1" Style="{StaticResource Cartao}" Margin="0,18,0,0" Padding="20,16"
                Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel>
                <TextBlock Text="BARRA DE FILTROS" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource TextoSuave}" Margin="0,0,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                        <TextBlock Text="Busca (Nome/CPF)" Style="{StaticResource Rotulo}"/>
                        <Border Height="38" CornerRadius="8" Background="#E9ECF0">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource TextoSuave}" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Margin="10,0,0,0">
                                    <TextBox x:Name="txtBusca" BorderThickness="0" Background="Transparent"
                                             FontSize="14" VerticalContentAlignment="Center"
                                             Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Digite Nome ou CPF..."
                                               Foreground="#5F6B7A" FontSize="14" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="2,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=txtBusca}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <RadioButton Style="{StaticResource ChipFiltro}"
                                     IsChecked="{Binding FiltroTipo, Converter={StaticResource FiltroValorParaBool}, ConverterParameter=Todos}">
                            <TextBlock Text="Todos"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChipFiltro}"
                                     IsChecked="{Binding FiltroTipo, Converter={StaticResource FiltroValorParaBool}, ConverterParameter=Proprietário}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Proprietários"/>
                                <Border Style="{StaticResource BadgeContagem}">
                                    <TextBlock Text="{Binding TotalProprietarios}" Style="{StaticResource TextoBadge}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChipFiltro}"
                                     IsChecked="{Binding FiltroTipo, Converter={StaticResource FiltroValorParaBool}, ConverterParameter=Comprador}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Compradores"/>
                                <Border Style="{StaticResource BadgeContagem}">
                                    <TextBlock Text="{Binding TotalCompradores}" Style="{StaticResource TextoBadge}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChipFiltro}" Margin="0"
                                     IsChecked="{Binding FiltroTipo, Converter={StaticResource FiltroValorParaBool}, ConverterParameter=Inquilino}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Inquilinos"/>
                                <Border Style="{StaticResource BadgeContagem}">
                                    <TextBlock Text="{Binding TotalInquilinos}" Style="{StaticResource TextoBadge}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============ CONTEÚDO: lista OU formulário ============ -->
        <Grid Grid.Row="2" Margin="0,18,0,0">

            <!-- LISTA -->
            <Border Style="{StaticResource Cartao}" Padding="20,8"
                    Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Clientes}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeColumns="False" CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeaderWidth="0" RowHeight="62"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              Background="Transparent" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource CabecalhoColuna}"
                              CellStyle="{StaticResource CelulaGrid}"
                              RowStyle="{StaticResource LinhaGrid}">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Nome" Width="1.5*" MinWidth="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="19"
                                                    Background="{StaticResource PrimariaClara}"
                                                    BorderBrush="{StaticResource Primaria}" BorderThickness="1.5">
                                                <TextBlock Text="{Binding Iniciais}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource Primaria}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Texto}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProfissaoTexto}" FontSize="12"
                                                           Foreground="{StaticResource TextoSuave}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="CPF" Binding="{Binding Cpf}" Width="130"
                                                ElementStyle="{StaticResource TextoCelula}"/>

                            <DataGridTextColumn Header="Telefone" Binding="{Binding TelefonePrincipal}" Width="130"
                                                ElementStyle="{StaticResource TextoCelula}"/>

                            <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="1.3*" MinWidth="150"
                                                ElementStyle="{StaticResource TextoCelula}"/>

                            <DataGridTemplateColumn Header="Tipo de Cliente" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F3F5F8" BorderBrush="#D9DEE5" BorderThickness="1"
                                                CornerRadius="12" Padding="12,3" Margin="8,0" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Tipo}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Texto}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                            <Ellipse Style="{StaticResource PontoStatus}"/>
                                            <TextBlock Text="{Binding StatusTexto}" Style="{StaticResource TextoStatusCliente}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Ações" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                            <Button Content="&#xE721;" ToolTip="Visualizar"
                                                    Style="{StaticResource BotaoAcao}"
                                                    Command="{Binding DataContext.VisualizarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="&#xE70F;" ToolTip="Editar"
                                                    Style="{StaticResource BotaoAcao}"
                                                    Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="&#xE74D;" ToolTip="Excluir"
                                                    Style="{StaticResource BotaoExcluirLinha}"
                                                    Command="{Binding DataContext.ExcluirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Mensagem quando os filtros não encontram nada -->
                    <TextBlock Text="Nenhum cliente encontrado com esses filtros."
                               Foreground="{StaticResource TextoSuave}" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Clientes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- FORMULÁRIO (Novo ou Editar) -->
            <Border Style="{StaticResource Cartao}" HorizontalAlignment="Stretch"
                    Visibility="{Binding MostrandoFormulario, Converter={StaticResource BoolParaVisibilidade}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho do cartão: ícone + título + excluir (só ao editar) -->
                    <Border Grid.Row="0" Background="#F7F8FA" CornerRadius="12,12,0,0"
                            BorderBrush="#E6E9EE" BorderThickness="0,0,0,1" Padding="24,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="42" Height="42" CornerRadius="8" Background="{StaticResource PrimariaClara}">
                                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{StaticResource Primaria}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TituloFormulario}" FontSize="17" FontWeight="Bold"
                                               Foreground="{StaticResource Texto}"/>
                                    <TextBlock Text="{Binding SubtituloFormulario}" FontSize="12"
                                               Foreground="{StaticResource TextoSuave}"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource BotaoTextoPerigo}"
                                    Command="{Binding ExcluirDoFormCommand}"
                                    Visibility="{Binding EditandoExistente, Converter={StaticResource BoolParaVisibilidade}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Excluir" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Campos: Dados Pessoais / Contato / Informações Adicionais (igual à Tela 5) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,4,24,24">

                        <TextBlock Text="DADOS PESSOAIS" Style="{StaticResource TituloSecaoForm}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nome Completo *" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding NomeForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CPF *" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding CpfForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="RG *" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding RgForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Órgão Emissor do RG *" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding OrgaoEmissorRgForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Data de Nascimento *" Style="{StaticResource Rotulo}"/>
                                <DatePicker Style="{StaticResource DataPickerForm}"
                                            SelectedDate="{Binding DataNascimentoForm, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nacionalidade *" Style="{StaticResource Rotulo}"/>
                                <ComboBox Style="{StaticResource ComboArredondado}"
                                          ItemsSource="{Binding Nacionalidades}"
                                          SelectedItem="{Binding NacionalidadeForm, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Grid.ColumnSpan="3">
                                <TextBlock Text="Estado Civil *" Style="{StaticResource Rotulo}"/>
                                <ComboBox Style="{StaticResource ComboArredondado}"
                                          ItemsSource="{Binding EstadosCivis}"
                                          SelectedItem="{Binding EstadoCivilForm, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="CONTATO" Style="{StaticResource TituloSecaoForm}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Telefone Principal *" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding TelefonePrincipalForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Telefone Secundário" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding TelefoneSecundarioForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="E-mail *" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding EmailForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="ENDEREÇO DE DOMICÍLIO" Style="{StaticResource TituloSecaoForm}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rua *" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding RuaForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Número *" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding NumeroForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Bairro *" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding BairroForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CEP *" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding CepForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.ColumnSpan="3">
                                <TextBlock Text="Cidade *" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding CidadeForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="INFORMAÇÕES ADICIONAIS" Style="{StaticResource TituloSecaoForm}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tipo de Cliente" Style="{StaticResource Rotulo}"/>
                                <ComboBox Style="{StaticResource ComboArredondado}"
                                          ItemsSource="{Binding TiposEnum}"
                                          SelectedItem="{Binding TipoForm, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Status" Style="{StaticResource Rotulo}"/>
                                <ComboBox Style="{StaticResource ComboArredondado}"
                                          ItemsSource="{Binding StatusesForm}"
                                          SelectedItem="{Binding StatusForm, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cargo / Profissão *" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding ProfissaoForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Empresa *" Style="{StaticResource Rotulo}"/>
                                <TextBox Style="{StaticResource CampoForm}"
                                         Text="{Binding EmpresaForm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding ErroForm}" Foreground="{StaticResource Perigo}"
                                   FontSize="13" TextWrapping="Wrap" Margin="0,16,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErroForm}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Rodapé: Cancelar no canto esquerdo, Salvar Cliente no direito -->
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Cancelar" Style="{StaticResource BotaoContorno}"
                                    Command="{Binding CancelarFormCommand}"/>

                            <Button Grid.Column="2" Style="{StaticResource BotaoPrimario}"
                                    Command="{Binding SalvarFormCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Salvar Cliente" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- DETALHES DO CLIENTE (ao clicar em Visualizar) -->
            <Border Style="{StaticResource Cartao}" VerticalAlignment="Top"
                    Visibility="{Binding MostrandoDetalhes, Converter={StaticResource BoolParaVisibilidade}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho: avatar com iniciais, nome, tipo e status -->
                    <Border Grid.Row="0" DataContext="{Binding ClienteDetalhe}"
                            Background="#F7F8FA" CornerRadius="12,12,0,0"
                            BorderBrush="#E6E9EE" BorderThickness="0,0,0,1" Padding="28,22">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="68" Height="68" CornerRadius="34" Background="{StaticResource PrimariaClara}"
                                    BorderBrush="{StaticResource Primaria}" BorderThickness="2">
                                <TextBlock Text="{Binding Iniciais}" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource Primaria}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Nome}" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource Texto}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Border Style="{StaticResource ChipDetalhe}">
                                        <TextBlock Text="{Binding Tipo}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Texto}"/>
                                    </Border>
                                    <Border Style="{StaticResource ChipDetalhe}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource PontoStatus}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusTexto}" Style="{StaticResource TextoStatusCliente}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Corpo: dados organizados por seção -->
                    <ScrollViewer Grid.Row="1" DataContext="{Binding ClienteDetalhe}"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24,28,24">
                            <StackPanel Margin="0,0,0,22">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource IconeSecaoDetalhe}">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource Primaria}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="DADOS PESSOAIS" Style="{StaticResource TituloSecaoDetalhe}"/>
                                </StackPanel>
                                <Border Style="{StaticResource CaixaDetalhe}">
                                    <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1.3*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nome Completo" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding Nome}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CPF" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding Cpf}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="RG" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding RgTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Órgão Emissor do RG" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding OrgaoEmissorRgTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1.3*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Data de Nascimento" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding NascimentoTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nacionalidade" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding NacionalidadeTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Grid.ColumnSpan="3">
                                        <TextBlock Text="Estado Civil" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding EstadoCivilTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,22">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource IconeSecaoDetalhe}">
                                        <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource Primaria}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="CONTATO" Style="{StaticResource TituloSecaoDetalhe}"/>
                                </StackPanel>
                                <Border Style="{StaticResource CaixaDetalhe}">
                                    <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Telefone Principal" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding TelefonePrincipalTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Telefone Secundário" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding TelefoneSecundarioTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="E-mail" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding Email}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,22">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource IconeSecaoDetalhe}">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource Primaria}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="ENDEREÇO DE DOMICÍLIO" Style="{StaticResource TituloSecaoDetalhe}"/>
                                </StackPanel>
                                <Border Style="{StaticResource CaixaDetalhe}">
                                    <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Rua" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding RuaTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Número" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding NumeroTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Bairro" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding BairroTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CEP" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding CepTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.ColumnSpan="3">
                                        <TextBlock Text="Cidade" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding CidadeTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource IconeSecaoDetalhe}">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource Primaria}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="INFORMAÇÕES ADICIONAIS" Style="{StaticResource TituloSecaoDetalhe}"/>
                                </StackPanel>
                                <Border Style="{StaticResource CaixaDetalhe}">
                                    <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Tipo de Cliente" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding Tipo}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Status" Style="{StaticResource RotuloDetalhe}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource PontoStatus}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusTexto}" FontSize="15"
                                                       Style="{StaticResource TextoStatusCliente}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Cargo / Profissão" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding ProfissaoTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Empresa" Style="{StaticResource RotuloDetalhe}"/>
                                        <TextBlock Text="{Binding EmpresaTexto}" Style="{StaticResource ValorDetalhe}"/>
                                    </StackPanel>
                                </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Rodapé: Voltar à esquerda; Excluir e Editar à direita -->
                    <Border Grid.Row="2" BorderBrush="#E6E9EE" BorderThickness="0,1,0,0" Padding="28,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource BotaoContorno}"
                                    Command="{Binding FecharDetalhesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Voltar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource BotaoTextoPerigo}" Height="42" Margin="0,0,10,0"
                                        Command="{Binding ExcluirDoDetalheCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Excluir" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BotaoPrimario}"
                                        Command="{Binding EditarDoDetalheCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Editar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
